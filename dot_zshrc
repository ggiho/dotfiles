eval "$(/opt/homebrew/bin/brew shellenv)"
eval "$(zoxide init zsh)"
eval "$(atuin init zsh)"

# --- user local executables ---
if [ -d "$HOME/.local/bin" ]; then
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) : ;;                 # already exists
    *) export PATH="$HOME/.local/bin:$PATH" ;;   # prepend
  esac
fi

# --- completions ---
# Nothing called compinit before, so the ~37 completions already on fpath
# (aws, kubectl, chezmoi, just, gh, docker, uv, ...) were never loaded, and the
# _bun source below was a no-op because compdef did not exist.
# brew shellenv appends the same site-functions dir three times; dedupe first.
typeset -U fpath
autoload -Uz compinit
# -i skips insecure files instead of prompting on every shell: Docker.app ships
# _docker-compose owned by jamfroot, which compaudit rejects and which cannot be
# chowned because MDM manages it.
# Rebuild the dump once a day; -C otherwise reuses it and skips the security
# scan (8ms vs ~350ms). The glob must be assigned to an array -- inside [[ -n ]]
# zsh does not expand it, so the widely-copied one-liner always takes the slow
# branch.
_zcompdump_stale=( $HOME/.zcompdump(N.mh+24) )
if (( $#_zcompdump_stale )); then
  compinit -i
else
  compinit -C -i
fi
unset _zcompdump_stale

# --- fzf-tab: replaces the completion menu with an fzf picker ---
# Must load after compinit but before plugins that wrap widgets (autosuggestions
# below), per the fzf-tab README.
zstyle ':completion:*' menu no                    # required: lets fzf-tab capture the prefix
zstyle ':completion:*' group-name ''              # group candidates by type
zstyle ':completion:*:descriptions' format '[%d]' # group headers; no escape codes, fzf-tab drops them
# Type either case and still match (zsh-native completions only -- cobra-based
# tools like chezmoi and gh filter case-sensitively inside their own binary).
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*:git-checkout:*' sort false  # keep git's own ref ordering
zstyle ':fzf-tab:*' switch-group '<' '>'          # move between groups
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
# Draw the picker in a tmux popup when inside tmux; plain fzf otherwise.
[[ -n $TMUX ]] && zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup
source /opt/homebrew/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh

source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#8a8a8a'

source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# Aliases
[ -f "$HOME/.config/zsh/aliases.zsh" ] && source "$HOME/.config/zsh/aliases.zsh"

# Custom zsh
[ -f "$HOME/.config/zsh/custom.zsh" ] && source "$HOME/.config/zsh/custom.zsh"

# Starship
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"

# mycli 2.x imports llm/openai at startup, which costs ~590ms. Skipping it
# cuts time-to-prompt from ~1.7s to ~0.85s. Disables the \llm command.
export MYCLI_LLM_OFF=1
eval "$(starship init zsh)"

export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"

# fastfetch

# opencode
# Was hardcoded to /Users/giho, which is not this account's home ($HOME is
# /Users/giho.seong), so this only ever added a nonexistent dir to PATH.
[ -d "$HOME/.opencode/bin" ] && export PATH="$HOME/.opencode/bin:$PATH"

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^O' edit-command-line

  # export EDITOR=nvim
  # export VISUAL=nvim

zstyle ':zle:edit-command-line' editor nvim
