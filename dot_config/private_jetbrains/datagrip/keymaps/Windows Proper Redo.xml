<keymap version="1" name="Windows Proper Redo" parent="$default">
  <action id="$Redo">
    <keyboard-shortcut first-keystroke="shift ctrl z" />
    <keyboard-shortcut first-keystroke="shift alt back_space" />
    <keyboard-shortcut first-keystroke="ctrl y" />
  </action>
  <action id="Arrangement.Rule.Edit" />
  <action id="ChangesView.Rename">
    <keyboard-shortcut first-keystroke="shift f6" />
  </action>
  <action id="Console.Jdbc.ExplainPlan.Raw">
    <keyboard-shortcut first-keystroke="ctrl input_method_on_off" />
  </action>
  <action id="Console.TableResult.EditValue">
    <keyboard-shortcut first-keystroke="enter" />
    <keyboard-shortcut first-keystroke="alt enter" />
  </action>
  <action id="Console.Toggle.Notebook.Mode">
    <keyboard-shortcut first-keystroke="ctrl quote" />
  </action>
  <action id="EditorCodeBlockEnd" />
  <action id="EditorDeleteLine" />
  <action id="EditorLineEnd">
    <keyboard-shortcut first-keystroke="end" />
    <keyboard-shortcut first-keystroke="ctrl semicolon" />
  </action>
  <action id="EditorLineStart">
    <keyboard-shortcut first-keystroke="home" />
    <keyboard-shortcut first-keystroke="shift ctrl semicolon" />
  </action>
  <action id="Git.Rename.Local.Branch">
    <keyboard-shortcut first-keystroke="shift f6" />
  </action>
  <action id="Git.Reword.Commit">
    <keyboard-shortcut first-keystroke="shift f6" />
  </action>
  <action id="GotoNextError" />
  <action id="Images.Editor.ToggleGrid" />
  <action id="NewSqlFile">
    <keyboard-shortcut first-keystroke="ctrl close_bracket" />
  </action>
  <action id="QuickEvaluateExpression">
    <keyboard-shortcut first-keystroke="ctrl alt f8" />
    <mouse-shortcut keystroke="alt button1" />
    <keyboard-shortcut first-keystroke="ctrl back_slash" />
  </action>
  <action id="RenameElement">
    <keyboard-shortcut first-keystroke="shift f6" />
    <keyboard-shortcut first-keystroke="f2" />
  </action>
  <action id="ShelvedChanges.Rename">
    <keyboard-shortcut first-keystroke="shift f6" />
  </action>
  <action id="XDebugger.EditWatch" />
  <action id="XDebugger.SetValue" />
  <action id="sql.SelectInDatabaseView">
    <keyboard-shortcut first-keystroke="shift alt b" />
    <mouse-shortcut keystroke="control button3" />
  </action>
</keymap>