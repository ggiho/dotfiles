;; Home Row Mods + Navigation Layer
;;
;;   A -> tap a / hold Left Control + Nav layer
;;   S -> tap s / hold Left Option(Alt)
;;   D -> tap d / hold Left Command(Meta)
;;   F -> tap f / hold Left Shift
;;   ; -> tap ; / hold Right Shift
;;
;; Nav layer (A hold + key):
;;   H=Left  J=Down  K=Up  L=Right  G=Home  ;=End
;;
;; Caps Lock -> macOS 기본 (한영전환)

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  ;; 빠른 타이핑 중 홈로우모드 modifier(Ctrl 등) 오발동/stuck 방지.
  ;; 직전에 다른 키를 눌렀으면 tap-hold를 즉시 tap으로 해소한다. (ZMK require-prior-idle-ms와 동일)
  tap-hold-require-prior-idle 150
  macos-dev-names-exclude (
    "Karabiner DriverKit VirtualHIDKeyboard 1.8.0"
    ;; TOTEM(블루투스 ZMK)은 kanata가 grab하지 않는다. 블루투스 재연결 시
    ;; grab이 안 풀린 채 재open을 시도해 exclusive access 충돌 → Ctrl stuck 버그를
    ;; 일으켰다. TOTEM 리매핑은 ZMK 펌웨어에서 처리한다.
    "TOTEM"
  )
)

(defsrc
  f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
  caps lctl a s d f g h ; x c v rmet rctl j k l i o m , .
)

(defchordsv2
  (a s) C-a 50 all-released ()
  (j k) bspc 50 all-released ()
  (k l) esc 50 all-released ()
  (, .) S-/ 50 all-released ()
  (j i) - 50 all-released ()
  (j o) = 50 all-released ()
  (x c) M-c 50 all-released ()
  (c v) M-v 50 all-released ()
  (j l) ' 50 all-released ()
  (m k) S-- 50 all-released ()
  (i o) ] 50 all-released ()
  (u i) [ 50 all-released ()
  (m ,) f18 50 all-released ()
)

(defalias
  nav_home (multi (release-key lctl) home)
  nav_left (multi (release-key lctl) left)
  nav_end  (multi (release-key lctl) end)
  nav_down (multi (release-key lctl) down)
  nav_up   (multi (release-key lctl) up)
  nav_rght (multi (release-key lctl) rght)

  a_hrm    (tap-hold      130 200 a (multi lctl (layer-while-held ctrl-nav)))
  s_hrm    (tap-hold      130 180 s lalt)
  d_hrm    (tap-hold      130 180 d lmet)
  f_hrm    (tap-hold        0 155 f lsft)
  scln_hrm (tap-hold-press  0 120 ; rsft)
)

(deflayer base
  brdn brup _ _ _ _ prev pp next mute vold volu
  caps lctl @a_hrm @s_hrm @d_hrm @f_hrm g h @scln_hrm x c v f18 f18 j k l i o m , .
)

(deflayer ctrl-nav
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ @nav_home @nav_left @nav_end _ _ _ _ _ @nav_down @nav_up @nav_rght i o m , .
)

;; (제거됨) defoverrides (lctl h/j/k/l)->방향키 는 TOTEM(외부 ctrl+hjkl)용이었다.
;; TOTEM을 macos-dev-names-exclude로 kanata grab 대상에서 뺐고, 내장 키보드는
;; ctrl-nav 레이어가 방향키를 처리하므로 defoverrides는 불필요 + lctl 이중처리로
;; Ctrl stuck을 악화시켜 제거했다. (2026-07-14)
