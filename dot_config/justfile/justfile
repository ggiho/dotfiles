# Table name list for the ddb-* pickers; ddb-describe and ddb-count both need it.
DDB_TABLES      := 'aws dynamodb list-tables --query "TableNames[]" --output text | tr "\t" "\n"'

# ddb-describe renders describe-table as a bordered, coloured summary. The jq
# pass emits tab-separated records (H header / F field / S section / K key /
# I index / D index-detail) and the awk pass measures them and draws the box --
# awk is needed because the width is only known after every line exists.
# explode/implode is jq's only way to insert thousands separators.
DDB_RECORDS_JQ  := '''
def commify:
  tostring | explode | reverse | to_entries
  | map(if (.key > 0 and .key % 3 == 0) then [44, .value] else [.value] end)
  | flatten | reverse | implode;
def human:
  if . == null then "?"
  elif . >= 1073741824 then "\((. / 1073741824 * 10 | round / 10)) GB"
  elif . >= 1048576    then "\((. / 1048576 * 10 | round / 10)) MB"
  elif . >= 1024       then "\((. / 1024 * 10 | round / 10)) KB"
  else "\(.) B" end;
.Table as $t
| (.TimeToLiveDescription // {}) as $ttl
| ($t.AttributeDefinitions | map({key: .AttributeName, value: .AttributeType}) | from_entries) as $ty
| def kl($ks; $kt): ($ks | map(select(.KeyType == $kt)) | first | .AttributeName);
def keytxt($ks):
    kl($ks; "HASH") as $h | kl($ks; "RANGE") as $r
    | "\($h) (\($ty[$h]))" + (if $r then "  +  \($r) (\($ty[$r]))" else "" end);
  ["H\t\($t.TableName)"]
+ ["F\tstatus\t\($t.TableStatus)"]
+ ["F\titems\t\($t.ItemCount | commify)"]
+ ["F\tsize\t\($t.TableSizeBytes | human)"]
+ ["F\tmode\t" + (if ($t.ProvisionedThroughput.ReadCapacityUnits // 0) > 0
      then "PROVISIONED   rcu=\($t.ProvisionedThroughput.ReadCapacityUnits)  wcu=\($t.ProvisionedThroughput.WriteCapacityUnits)"
      else "PAY_PER_REQUEST" end)]
+ (if $ttl.TimeToLiveStatus
   then ["F\tttl\t" + $ttl.TimeToLiveStatus
         + (if $ttl.AttributeName then "   (\($ttl.AttributeName))" else "" end)]
   else [] end)
+ (if $t.DeletionProtectionEnabled then ["F\tprotect\tdelete-protection ON"] else [] end)
+ ["S\tkeys", "K\t" + keytxt($t.KeySchema)]
+ (if (($t.GlobalSecondaryIndexes // []) + ($t.LocalSecondaryIndexes // [])) | length > 0
   then ["S\tindexes"] else [] end)
+ (($t.GlobalSecondaryIndexes // []) | map(
     "I\tGSI\t\(.IndexName)\t\(.Projection.ProjectionType // "")",
     "D\t" + keytxt(.KeySchema)) | flatten)
+ (($t.LocalSecondaryIndexes // []) | map(
     "I\tLSI\t\(.IndexName)\t",
     "D\t" + keytxt(.KeySchema)) | flatten)
| .[]
'''

DDB_BOX_AWK     := '''
BEGIN {
  FS = "\t"
  # Catppuccin mocha, matching ~/.myclirc and the fzf theme. Empty when the
  # output is not a terminal so redirected output stays plain.
  if (COLOR) {
    B  = "\033[38;2;88;91;112m"    # surface2  border
    T  = "\033[1;38;2;203;166;247m" # mauve    title
    L  = "\033[38;2;108;112;134m"  # overlay0  label
    V  = "\033[38;2;205;214;244m"  # text      value
    A  = "\033[38;2;137;180;250m"  # blue      key / index name
    G  = "\033[38;2;166;227;161m"  # green     ACTIVE
    R  = "\033[38;2;243;139;168m"  # red       not ACTIVE
    Y  = "\033[38;2;249;226;175m"  # yellow    projection
    Z  = "\033[0m"
  }
}
{ rec[NR] = $0 }
function vis(s) { gsub(/\033\[[0-9;]*m/, "", s); return length(s) }
END {
  # First pass: build the plain text of every line so the width is known before
  # any border is drawn.
  for (i = 1; i <= NR; i++) {
    n = split(rec[i], f, FS)
    k = f[1]
    if (k == "H")      { plain[i] = f[2];                     kind[i] = "H" }
    else if (k == "F") { plain[i] = sprintf("%-9s %s", f[2], f[3]); kind[i] = "F"; lab[i] = f[2]; val[i] = f[3] }
    else if (k == "S") { plain[i] = f[2];                     kind[i] = "S" }
    else if (k == "K") { plain[i] = sprintf("%-9s %s", "PK", f[2]); kind[i] = "K"; val[i] = f[2] }
    else if (k == "I") { plain[i] = sprintf("%-9s %s%s", f[2], f[3], (f[4] != "" ? "   [" f[4] "]" : "")); kind[i] = "I"; lab[i] = f[2]; val[i] = f[3]; proj[i] = f[4] }
    else if (k == "D") { plain[i] = sprintf("%-9s %s", "", f[2]); kind[i] = "D"; val[i] = f[2] }
    if (length(plain[i]) > w) w = length(plain[i])
  }
  w += 2
  head = rec[1]; sub(/^H\t/, "", head)
  printf "%s╭─ %s%s%s ", B, T, head, B
  for (i = vis(head) + 3; i < w; i++) printf "─"
  printf "╮%s\n", Z

  for (i = 2; i <= NR; i++) {
    if (kind[i] == "S") {
      printf "%s├─ %s%s%s ", B, L, plain[i], B
      for (j = vis(plain[i]) + 3; j < w; j++) printf "─"
      printf "┤%s\n", Z
      continue
    }
    if (kind[i] == "F") {
      c = V
      if (lab[i] == "status") c = (val[i] == "ACTIVE" ? G : R)
      if (lab[i] == "protect") c = Y
      if (lab[i] == "ttl") c = (val[i] ~ /^ENABLED/ ? Y : L)
      body = sprintf("%s%-9s%s %s%s%s", L, lab[i], Z, c, val[i], Z)
    } else if (kind[i] == "K") {
      body = sprintf("%s%-9s%s %s%s%s", L, "PK", Z, A, val[i], Z)
    } else if (kind[i] == "I") {
      body = sprintf("%s%-9s%s %s%s%s", L, lab[i], Z, A, val[i], Z)
      if (proj[i] != "") body = body sprintf("   %s[%s]%s", Y, proj[i], Z)
    } else {
      body = sprintf("%-9s %s%s%s", "", V, val[i], Z)
    }
    pad = w - vis(plain[i])
    printf "%s│%s %s", B, Z, body
    for (j = 0; j < pad - 1; j++) printf " "
    printf "%s│%s\n", B, Z
  }
  printf "%s╰", B
  for (i = 0; i < w; i++) printf "─"
  printf "╯%s\n", Z
}
'''

# Host picker + Keychain auth for the Postgres/Redshift recipes. Only pg-typed
# entries in the hosts file (field 5) are offered.
PG_CONNECT       := '''
setup_pg() {
  local sel raw
  raw=$(grep -vE "^#|^$" "$HOSTS_FILE" | grep -E ":(pg|postgres|postgresql)(:|$)" \
    | awk -F: "{printf \"%s\\t%-22s %s:%s/%s\\n\", \$0, \$1, \$2, \$3, \$6}" \
    | fzf --prompt="pg host> " --height=40% --scheme=default --delimiter="\t" --with-nth=2) || true
  [ -n "$raw" ] || return 1
  raw=$(printf "%s\n" "$raw" | cut -f1)
  export PGHOST=$(printf "%s" "$raw" | cut -d: -f2)
  export PGPORT=$(printf "%s" "$raw" | cut -d: -f3)
  export PGUSER=$(printf "%s" "$raw" | cut -d: -f4)
  export PGDATABASE=$(printf "%s" "$raw" | cut -d: -f6)
  export PGPASSWORD=$(security find-generic-password -s "mysql-db-connect" -a "$PGUSER" -w 2>/dev/null || true)
  [ -n "$PGPASSWORD" ] || { echo "No Keychain entry for $PGUSER" >&2; return 1; }
  [ -n "$PGDATABASE" ] || export PGDATABASE=dev
  echo ">> $(printf "%s" "$raw" | cut -d: -f1)  ($PGHOST:$PGPORT/$PGDATABASE as $PGUSER)" >&2
}
# $PGQ_PYTHON / $PGQ_PY are set by each recipe: a {{...}} inside a raw-string
# variable is inserted literally, not expanded again, so they cannot be
# referenced directly from here.
pgq() { "$PGQ_PYTHON" "$PGQ_PY" "$@"; }
'''

# Host picker + Keychain auth shared by the mysql-* diagnostics. Sets $host,
# $port, $user and defines run_sql, which pipes a query through MYSQL_PWD so the
# password never reaches argv.
MYSQL_CONNECT    := '''
pick_host() {
  # fzf shows the formatted second field but returns the whole line, so the raw
  # hosts entry survives for parsing. Splitting the display on whitespace does
  # not work: labels contain spaces ("OnTheGo DEV").
  local sel
  sel=$(grep -vE "^#|^$" "$HOSTS_FILE" | grep -vE ":(pg|postgres|postgresql)(:|$)" \
    | awk -F: "{printf \"%s\\t%-26s %s:%s\\n\", \$0, \$1, \$2, \$3}" \
    | fzf --prompt="$1> " --height=40% --scheme=default --delimiter="\t" --with-nth=2) || true
  [ -n "$sel" ] || return 1
  printf "%s\n" "$sel" | cut -f1
}
setup_conn() {
  local raw
  # $2, when given, is a raw hosts-file line -- mysql-diff picks the pair once and
  # hands them down so each comparison does not re-ask.
  if [ -n "${2:-}" ]; then raw="$2"; else raw=$(pick_host "${1:-host}") || return 1; fi
  [ -n "$raw" ] || return 1
  raw_line="$raw"
  label=$(printf "%s" "$raw" | cut -d: -f1)
  host=$(printf "%s" "$raw" | cut -d: -f2)
  port=$(printf "%s" "$raw" | cut -d: -f3)
  user=$(printf "%s" "$raw" | cut -d: -f4)
  pw=$(security find-generic-password -s "mysql-db-connect" -a "$user" -w 2>/dev/null || true)
  [ -n "$pw" ] || { echo "No Keychain entry for $user" >&2; return 1; }
  # Stay quiet when the caller pre-picked the host: mysql-diff already announced
  # the pair, and the child recipes would repeat it for every comparison.
  [ -n "${2:-}" ] || echo ">> $label  ($host:$port as $user)" >&2
}
run_sql() { MYSQL_PWD="$pw" mysql -h "$host" -P "$port" -u "$user" --connect-timeout=10 -B "$@"; }
'''

# Bordered-table renderer shared by every recipe that prints tabular output.
TABLE_PY        := justfile_directory() + "/lib/table.py"
# psql is not installed; these run through the pgcli tool venv, which has psycopg.
PGQ_PY          := justfile_directory() + "/lib/pgq.py"
PGQ_PYTHON      := env_var_or_default("PGQ_PYTHON", env_var("HOME") + "/.local/share/uv/tools/pgcli/bin/python")
# Parses the Aurora audit CSV (quoted query field, microsecond timestamps).
AUDIT_TSV_PY    := justfile_directory() + "/lib/audit_tsv.py"

# Flattens a scan/query response into TSV for DDB_TABLE_PY. DynamoDB values are
# type-tagged ({S: ...}, {N: ...}, ...), so each has to be unwrapped; containers
# are shown as a count rather than expanded.
DDB_ITEMS_JQ    := '''
def flat:
  if type != "object" then tostring
  elif has("S") then .S
  elif has("N") then .N
  elif has("BOOL") then (.BOOL | tostring)
  elif has("NULL") then "null"
  elif has("L") then "[\(.L | length)]"
  elif has("M") then "{\(.M | keys | length)}"
  elif has("SS") then "[\(.SS | length) str]"
  elif has("NS") then "[\(.NS | length) num]"
  elif has("B") then "<binary>"
  else tostring end;
def trunc($n): if (. | length) > $n then (.[0:$n-1] + "…") else . end;
(.Items // []) as $items
| ($items | map(keys) | add // [] | unique) as $allkeys
| (if $COLS == "" then $allkeys[0:$MAXC] else ($COLS | split(",") | map(ltrimstr(" ") | rtrimstr(" "))) end) as $cols
| [ ($cols | join("\t")) ]
+ ( $items | map([ $cols[] as $c | (.[$c] as $v
      # A missing attribute prints empty; an actual NULL-typed value prints
      # "null", so the two stay distinguishable.
      | if $v == null then "" else ($v | flat | gsub("[\n\t]"; " ") | trunc($W)) end) ] | join("\t")) )
| .[]
'''

# Picker shared by the ddb-* recipes. fzf with --print-query, so a value that is
# not in the candidate list can still be typed in.
DDB_PICK        := '''
pick_or_type() {
  local out sel
  out=$(fzf --prompt="$1> " --height=40% --scheme=default --print-query) || true
  # --print-query puts the typed text on line 1 and the selection on line 2.
  sel=$(printf '%s\n' "$out" | sed -n 2p)
  [ -n "$sel" ] || sel=$(printf '%s\n' "$out" | sed -n 1p)
  printf '%s\n' "$sel"
}
'''
