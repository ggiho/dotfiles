# Aurora/RDS user migration

# hint: source_host: e.g. aurora-dev.otg.apac.npr.aws.asurion.net
# hint: source_user: e.g. giho.seong
# hint: raw_sql: output file for raw pt-show-grants result

mysql-export-users source_host source_user raw_sql="users_raw.sql":
  #!/usr/bin/env bash
  set -euo pipefail
  pt-show-grants --host="{{source_host}}" --user="{{source_user}}" --ask-pass > "{{raw_sql}}"
  echo "Written: {{raw_sql}}"

# hint: input_sql: raw SQL from pt-show-grants
# hint: output_sql: sanitized output file for Aurora/RDS

mysql-sanitize-users input_sql="users_raw.sql" output_sql="users_sanitized.sql":
  #!/usr/bin/env bash
  set -euo pipefail
  python3 "{{SANITIZE_SCRIPT}}" "{{input_sql}}" "{{output_sql}}"
  echo "Written: {{output_sql}}"

# hint: input_sql: sanitized SQL to validate before import

mysql-check-users input_sql="users_sanitized.sql":
  #!/usr/bin/env bash
  set -euo pipefail
  echo "== internal/system accounts =="
  grep -nE 'rdsadmin|mysql\.session|mysql\.sys|mysql\.infoschema|rds_superuser_role' "{{input_sql}}" || echo "  (none)"
  echo ""
  echo "== inline DEFAULT ROLE in ALTER USER =="
  grep -nE '^ALTER USER .* DEFAULT ROLE ' "{{input_sql}}" || echo "  (none)"
  echo ""
  echo "== risky privileges =="
  grep -nE 'SUPER|SYSTEM_VARIABLES_ADMIN|SESSION_VARIABLES_ADMIN|BINLOG_ADMIN|ROLE_ADMIN|SET_USER_ID|FILE|SHUTDOWN' "{{input_sql}}" || echo "  (none)"

# hint: source_host: e.g. aurora-dev.otg.apac.npr.aws.asurion.net
# hint: source_user: e.g. giho.seong
# hint: raw_sql: intermediate raw grants file
# hint: sanitized_sql: final Aurora-compatible output file

mysql-dump-users source_host source_user raw_sql="users_raw.sql" sanitized_sql="users_sanitized.sql":
  #!/usr/bin/env bash
  set -euo pipefail

  echo "[1/3] Dumping grants from {{source_host}}..."
  pt-show-grants --host="{{source_host}}" --user="{{source_user}}" --ask-pass > "{{raw_sql}}"
  echo "  Written: {{raw_sql}}"

  echo "[2/3] Sanitizing for Aurora/RDS..."
  python3 "{{SANITIZE_SCRIPT}}" "{{raw_sql}}" "{{sanitized_sql}}"
  echo "  Written: {{sanitized_sql}}"

  echo "[3/3] Checking for leftover issues..."
  issues=0
  if grep -qE 'rdsadmin|mysql\.session|mysql\.sys|mysql\.infoschema|rds_superuser_role' "{{sanitized_sql}}"; then
    echo "  [WARN] internal/system accounts found:"
    grep -nE 'rdsadmin|mysql\.session|mysql\.sys|mysql\.infoschema|rds_superuser_role' "{{sanitized_sql}}"
    issues=$((issues + 1))
  fi
  if grep -qE '^ALTER USER .* DEFAULT ROLE ' "{{sanitized_sql}}"; then
    echo "  [WARN] inline DEFAULT ROLE in ALTER USER:"
    grep -nE '^ALTER USER .* DEFAULT ROLE ' "{{sanitized_sql}}"
    issues=$((issues + 1))
  fi
  if grep -qE 'SUPER|SYSTEM_VARIABLES_ADMIN|SESSION_VARIABLES_ADMIN|BINLOG_ADMIN|ROLE_ADMIN|SET_USER_ID|FILE|SHUTDOWN' "{{sanitized_sql}}"; then
    echo "  [WARN] risky privileges found:"
    grep -nE 'SUPER|SYSTEM_VARIABLES_ADMIN|SESSION_VARIABLES_ADMIN|BINLOG_ADMIN|ROLE_ADMIN|SET_USER_ID|FILE|SHUTDOWN' "{{sanitized_sql}}"
    issues=$((issues + 1))
  fi
  if [ "$issues" -eq 0 ]; then
    echo "  OK — no issues found"
  fi
  echo ""
  echo "Review {{sanitized_sql}}, then run: just mysql-import-users <target_host> <target_user> {{sanitized_sql}}"

# hint: target_host: e.g. aurora-skt-otg-uat-cluster.cluster-czdk59pd0a4y.ap-northeast-2.rds.amazonaws.com
# hint: target_user: e.g. giho.seong
# hint: input_sql: sanitized SQL to import

mysql-import-users target_host target_user input_sql="users_sanitized.sql":
  #!/usr/bin/env bash
  set -euo pipefail
  mysql --host="{{target_host}}" --user="{{target_user}}" --password < "{{input_sql}}"
  echo "Imported: {{input_sql}}"

# hint: host: e.g. aurora-dev.otg.apac.npr.aws.asurion.net
# hint: user: e.g. giho.seong

mysql-binlog-status host user:
  #!/usr/bin/env bash
  set -euo pipefail
  echo "== Current binlog position =="
  mysql --host="{{host}}" --user="{{user}}" --password \
    -e "SHOW MASTER STATUS\G"
  echo ""
  echo "== Available binary logs =="
  mysql --host="{{host}}" --user="{{user}}" --password \
    -e "SHOW BINARY LOGS"

# hint: host: e.g. aurora-dev.otg.apac.npr.aws.asurion.net
# hint: user: e.g. giho.seong
# hint: binlog: binlog filename (from mysql-binlog-status)
# hint: start_datetime: e.g. "2026-03-17 09:00:00"
# hint: stop_datetime: e.g. "2026-03-17 10:00:00"
# hint: output: output SQL file (default: binlog_recover_<timestamp>.sql)

mysql-binlog-extract host user binlog start_datetime stop_datetime output="":
  #!/usr/bin/env bash
  set -euo pipefail
  timestamp=$(date +%Y%m%d_%H%M%S)
  out="{{output}}"
  [ -z "$out" ] && out="binlog_recover_${timestamp}.sql"
  mysqlbinlog \
    --read-from-remote-server \
    --host="{{host}}" \
    --user="{{user}}" \
    --password \
    --start-datetime="{{start_datetime}}" \
    --stop-datetime="{{stop_datetime}}" \
    "{{binlog}}" > "$out"
  echo "Written: $out"
  echo "Review $out, then run: mysql --host=<target> --user=<user> --password < $out"

# hint: host: e.g. aurora-dev.otg.apac.npr.aws.asurion.net
# hint: user: e.g. giho.seong
# hint: binlog: binlog filename (from mysql-binlog-status)
# hint: start_position: start position (from SHOW MASTER STATUS)
# hint: stop_position: stop position
# hint: output: output SQL file (default: binlog_recover_<timestamp>.sql)

mysql-binlog-extract-pos host user binlog start_position stop_position output="":
  #!/usr/bin/env bash
  set -euo pipefail
  timestamp=$(date +%Y%m%d_%H%M%S)
  out="{{output}}"
  [ -z "$out" ] && out="binlog_recover_${timestamp}.sql"
  mysqlbinlog \
    --read-from-remote-server \
    --host="{{host}}" \
    --user="{{user}}" \
    --password \
    --start-position="{{start_position}}" \
    --stop-position="{{stop_position}}" \
    "{{binlog}}" > "$out"
  echo "Written: $out"
  echo "Review $out, then run: mysql --host=<target> --user=<user> --password < $out"

# AWS DMS

DMS_CLI := "cd " + DMSCTL_ROOT + "/cli && uv run dms"

# DMS 전체 상태 (diff 기반: AWS vs 코드)
dms-status:
  {{DMS_CLI}} status

# hint: task: e.g. prod-finance / prod-dax-master (빈값이면 전체)
# hint: source: dax / horizon / otg / soho (옵션)
dms-diff task="" source="":
  #!/usr/bin/env bash
  set -euo pipefail
  cd "$DMSCTL_ROOT/cli"
  if [ -n "{{task}}" ] && [ -n "{{source}}" ]; then
    uv run dms diff "{{task}}" --source "{{source}}"
  elif [ -n "{{task}}" ]; then
    uv run dms diff "{{task}}"
  elif [ -n "{{source}}" ]; then
    uv run dms diff --source "{{source}}"
  else
    uv run dms diff
  fi

# hint: task: e.g. prod-finance / all
dms-sync task dry_run="true":
  #!/usr/bin/env bash
  set -euo pipefail
  cd "$DMSCTL_ROOT/cli"
  if [ "{{dry_run}}" = "true" ]; then
    uv run dms sync {{task}} --dry-run
  else
    uv run dms sync {{task}} --force
  fi

# hint: target: e.g. prod-finance / horizon / all
dms-deploy target plan="false":
  #!/usr/bin/env bash
  set -euo pipefail
  cd "$DMSCTL_ROOT/cli"
  if [ "{{plan}}" = "true" ]; then
    uv run dms deploy {{target}} --plan
  else
    uv run dms deploy {{target}}
  fi

# hint: task: e.g. new-task-name
# hint: source: dax / horizon / otg / soho
# hint: tables: e.g. TABLE1,TABLE2 (또는 --from-aws 사용시 빈값)
# hint: from_aws: 기존 AWS task ID에서 import (빈값이면 tables 사용)
dms-generate task source tables="" from_aws="":
  #!/usr/bin/env bash
  set -euo pipefail
  cd "$DMSCTL_ROOT/cli"
  if [ -n "{{from_aws}}" ]; then
    uv run dms generate "{{task}}" --source "{{source}}" --from-aws "{{from_aws}}"
  else
    uv run dms generate "{{task}}" --source "{{source}}" --tables "{{tables}}"
  fi

# hint: task: e.g. prod-finance
# hint: table: e.g. NEW_TABLE
dms-table-add task table:
  {{DMS_CLI}} tables add "{{task}}" "{{table}}"

# hint: task: e.g. prod-finance
# hint: table: e.g. OLD_TABLE
dms-table-remove task table:
  {{DMS_CLI}} tables remove "{{task}}" "{{table}}"

# hint: task: e.g. prod-finance
dms-table-list task:
  {{DMS_CLI}} tables list "{{task}}"

# hint: task: e.g. prod-finance / all
dms-stop task:
  {{DMS_CLI}} task stop {{task}}

# hint: task: e.g. prod-finance / all
dms-resume task:
  {{DMS_CLI}} task resume {{task}}

# hint: task: e.g. prod-finance (빈값이면 전체)
# hint: source: dax / horizon / otg / soho (옵션)
dms-task-status task="" source="":
  #!/usr/bin/env bash
  set -euo pipefail
  cd "$DMSCTL_ROOT/cli"
  if [ -n "{{task}}" ] && [ -n "{{source}}" ]; then
    uv run dms task status "{{task}}" --source "{{source}}"
  elif [ -n "{{task}}" ]; then
    uv run dms task status "{{task}}"
  elif [ -n "{{source}}" ]; then
    uv run dms task status --source "{{source}}"
  else
    uv run dms task status
  fi

# hint: task: e.g. prod-finance
dms-table-status task:
  {{DMS_CLI}} task table-status {{task}}

# hint: source: dax / horizon / otg / soho (옵션, 빈값이면 전체)
dms-stats source="":
  #!/usr/bin/env bash
  set -euo pipefail
  cd "$DMSCTL_ROOT/cli"
  if [ -n "{{source}}" ]; then
    uv run dms task stats --source "{{source}}"
  else
    uv run dms task stats
  fi

dms-validate:
  {{DMS_CLI}} validate

