    FROM performance_schema.global_status WHERE VARIABLE_NAME='Uptime'" \
    | COLOR="$color" python3 "{{TABLE_PY}}"

# 느린 쿼리 전문 조회

# performance_schema digest 는 90자로 잘려 나오니, 하나를 골라 전문을 본다.
# DIGEST_TEXT 는 리터럴이 ? 로 정규화되고 performance_schema_max_digest_length
# (기본 1024자) 에서 잘린다. 리터럴이 든 실제 쿼리는 mysql-slowlog 를 쓴다.
# hint: top: 고를 후보 수 (default: 30)
[group('mysql')]
mysql-query-full top="30":
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  {{MYSQL_CONNECT}}
  setup_conn "host" || exit 0

  # Two columns, not one CONCAT with an embedded tab: batch mode (-B) escapes a
  # tab inside a value as the two characters \t, which fzf then cannot split on.
  # Separate columns are emitted with a real tab.
  sel=$(run_sql -Nse "
    SELECT DIGEST,
           CONCAT(LPAD(ROUND(SUM_TIMER_WAIT/1e12,1), 8, ' '), 's  ',
                  LPAD(COUNT_STAR, 8, ' '), 'x  ',
                  RPAD(IFNULL(SCHEMA_NAME,'-'), 14, ' '), '  ',
                  LEFT(REPLACE(DIGEST_TEXT, '\n', ' '), 110))
    FROM performance_schema.events_statements_summary_by_digest
    WHERE DIGEST IS NOT NULL
    ORDER BY SUM_TIMER_WAIT DESC LIMIT {{top}}" \
    | fzf --prompt="query> " --height=60% --scheme=default --delimiter="\t" --with-nth=2) || true
  [ -n "$sel" ] || exit 0
  digest=$(printf '%s\n' "$sel" | cut -f1)

  # -E (vertical) rather than the tab-separated default: one label per line reads
  # far better for a single row with this many columns.
  run_sql -E -e "
    SELECT SCHEMA_NAME, COUNT_STAR, ROUND(SUM_TIMER_WAIT/1e12,3) AS total_s,
           ROUND(AVG_TIMER_WAIT/1e9,3) AS avg_ms, ROUND(MAX_TIMER_WAIT/1e9,3) AS max_ms,
           SUM_ROWS_SENT AS rows_sent, SUM_ROWS_EXAMINED AS rows_examined,
           SUM_NO_INDEX_USED AS no_index_used, FIRST_SEEN, LAST_SEEN
    FROM performance_schema.events_statements_summary_by_digest
    WHERE DIGEST = '$digest'" | grep -v '^\*\+ '

  echo
  echo "── full DIGEST_TEXT ───────────────────────────────────────────────"
  # -N -r keeps the text raw and unwrapped; the table renderer would truncate it.
  run_sql -Nre "
    SELECT DIGEST_TEXT FROM performance_schema.events_statements_summary_by_digest
    WHERE DIGEST = '$digest'"
  echo "───────────────────────────────────────────────────────────────────"
  len=$(run_sql -Nse "SELECT CHAR_LENGTH(DIGEST_TEXT) FROM performance_schema.events_statements_summary_by_digest WHERE DIGEST = '$digest'")
  limit=$(run_sql -Nse "SELECT @@performance_schema_max_digest_length")
  echo "length: $len / digest limit: $limit" >&2
  [ "$len" -ge "$limit" ] && echo "NOTE: at the digest limit, so the text above is cut off." >&2 || true

# Aurora 의 slowquery 로그를 CloudWatch 에서 가져온다. 여기에는 리터럴이 든
# 쿼리 전문이 그대로 들어 있어서 pt-query-digest 로 바로 분석할 수 있다.
# hint: cluster: 클러스터 (비우면 slowquery 내보내기가 켜진 것만 fzf)
# hint: hours: 최근 N시간 (default: 24)
# hint: digest: true 면 pt-query-digest 분석, 기본은 원문
[group('mysql')]
mysql-slowlog cluster="" hours="24" digest="false":
  #!/usr/bin/env bash
  set -euo pipefail
  {{DDB_PICK}}

  cl="{{cluster}}"
  if [ -z "$cl" ]; then
    # Only clusters that actually export slowquery; the rest have no log group.
    cl=$(aws rds describe-db-clusters \
      --query "DBClusters[?contains(EnabledCloudwatchLogsExports || [], 'slowquery')].DBClusterIdentifier" \
      --output text | tr '\t' '\n' | sort | pick_or_type "cluster")
    [ -n "$cl" ] || exit 0
  fi
  lg="/aws/rds/cluster/$cl/slowquery"
  start=$(( ($(date +%s) - {{hours}} * 3600) * 1000 ))

  log=$(mktemp); trap 'rm -f "$log"' EXIT
  # filter-log-events spans every stream in the group, unlike get-log-events.
  aws logs filter-log-events --log-group-name "$lg" --start-time "$start" \
    --query 'events[].message' --output text 2>/dev/null | tr '\t' '\n' > "$log" || true

  if [ ! -s "$log" ]; then
    echo "No slow queries in $lg over the last {{hours}}h." >&2
    echo "long_query_time on this cluster may be higher than any query takes." >&2
    exit 0
  fi
  echo ">> $cl: $(grep -c '^# Time:' "$log" || true) slow queries in the last {{hours}}h" >&2

  if [ "{{digest}}" = "true" ]; then
    pt-query-digest "$log"
  else
    cat "$log"
  fi

# audit 로그에서 키값으로 쿼리 찾기. server_audit_query_log_limit 이 65536 이라
# digest 의 1024자 상한과 무관하게 전문이 남는다. QUERY 이벤트가 켜져 있어야 한다.
# hint: value: 찾을 문자열 (주문번호, ID, 테이블명 등)
# hint: cluster: 비우면 audit 내보내기가 켜진 클러스터만 fzf
# hint: hours: 최근 N시간 (default: 1 — audit 로그는 GB 단위라 좁게 시작하는 게 좋다)
# hint: only_query: true 면 QUERY 이벤트만 (READ/TABLE 행 제외)
[group('mysql')]
mysql-audit-search value cluster="" hours="1" only_query="true":
  #!/usr/bin/env bash
  set -euo pipefail
  {{DDB_PICK}}

  cl="{{cluster}}"
  if [ -z "$cl" ]; then
    cl=$(aws rds describe-db-clusters \
      --query "DBClusters[?contains(EnabledCloudwatchLogsExports || [], 'audit')].DBClusterIdentifier" \
      --output text | tr '\t' '\n' | sort | pick_or_type "cluster")
    [ -n "$cl" ] || exit 0
  fi
  lg="/aws/rds/cluster/$cl/audit"
  size=$(aws logs describe-log-groups --log-group-name-prefix "$lg" \
    --query 'logGroups[0].storedBytes' --output text 2>/dev/null || echo 0)
  echo ">> $cl audit ($(( size / 1048576 )) MB stored), last {{hours}}h, pattern: {{value}}" >&2

  start=$(( ($(date +%s) - {{hours}} * 3600) * 1000 ))
  color=1; { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0

  raw=$(mktemp); trap 'rm -f "$raw"' EXIT
  # Server-side --filter-pattern keeps the scan on CloudWatch's side; pulling the
  # whole window down and grepping locally would move gigabytes.
  aws logs filter-log-events --log-group-name "$lg" --start-time "$start" \
    --filter-pattern "{{value}}" --query 'events[].message' --output text 2>/dev/null \
    | tr '\t' '\n' > "$raw" || true

  if [ "{{only_query}}" = "true" ]; then
    # READ/TABLE rows name the table but carry no SQL, so they trebles the row
    # count without adding anything when you are after the statement itself.
    grep -E ',(QUERY|QUERY_DML|QUERY_DDL|QUERY_DCL),' "$raw" > "$raw.q" || true
    mv "$raw.q" "$raw"
  fi

  CELL=100 python3 "{{AUDIT_TSV_PY}}" < "$raw" | COLOR="$color" CELL=100 python3 "{{TABLE_PY}}"

# MySQL 환경 비교

# dump/load 후 소스와 타깃의 데이터가 같은지 확인.
# pt-table-checksum 은 master->replica 모델이라 독립된 두 호스트에는 맞지 않아서
# CHECKSUM TABLE + COUNT(*) 를 양쪽에서 직접 비교한다.
# hint: tables: 비교할 테이블 (콤마 구분, 비우면 fzf 다중선택)
[group('mysql')]
mysql-checksum tables="" source="" target="":
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  {{MYSQL_CONNECT}}
  sql_on() { local h=$1 p=$2 u=$3 w=$4; shift 4; MYSQL_PWD="$w" mysql -h "$h" -P "$p" -u "$u" --connect-timeout=10 -B "$@"; }

  setup_conn "source host" "{{source}}" || exit 0
  sh=$host sp=$port su=$user sw=$pw slabel=$label
  db=$(sql_on "$sh" "$sp" "$su" "$sw" -Nse \
    "SELECT schema_name FROM information_schema.schemata
     WHERE schema_name NOT IN ('mysql','sys','information_schema','performance_schema')
     ORDER BY schema_name" | fzf --prompt="schema> " --height=40% --scheme=default) || true
  [ -n "$db" ] || exit 0

  all_marker="(all tables)"
  list_tables() {
    sql_on "$sh" "$sp" "$su" "$sw" -D "$db" -Nse \
      "SELECT table_name FROM information_schema.tables
       WHERE table_schema=DATABASE() AND table_type='BASE TABLE' ORDER BY table_name"
  }
  if [ -n "{{tables}}" ]; then
    tbls=$(printf '%s' "{{tables}}" | tr ',' '\n')
  else
    # fzf's Enter returns the highlighted row even with --multi, so an empty
    # selection cannot mean "all". Offer it as an explicit first entry instead.
    sel=$( { printf '%s\n' "$all_marker"; list_tables; } \
      | fzf --multi --prompt="tables (Tab=multi)> " --height=60% --scheme=default) || true
    [ -n "$sel" ] || exit 0
    if printf '%s\n' "$sel" | grep -qxF "$all_marker"; then tbls=$(list_tables); else tbls="$sel"; fi
  fi
  [ -n "$tbls" ] || exit 0

  setup_conn "target host" "{{target}}" || exit 0
  th=$host tp=$port tu=$user tw=$pw tlabel=$label
  color=1; { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0
  echo ">> ${slabel} -> ${tlabel}   schema: $db   tables: $(printf '%s\n' "$tbls" | grep -c .)" >&2

  # Batch both queries: CHECKSUM TABLE takes a table list, and the counts go in one
  # UNION ALL. That keeps it at two round trips per host no matter how many tables.
  qualified=$(printf '%s\n' "$tbls" | grep . | sed "s/.*/\`$db\`.\`&\`/" | paste -sd, -)
  counts_sql=$(printf '%s\n' "$tbls" | grep . \
    | awk -v d="$db" '{printf "%sSELECT \"%s\" t, COUNT(*) n FROM `%s`.`%s`", (NR>1 ? " UNION ALL " : ""), $0, d, $0}')

  tmpdir=$(mktemp -d); trap 'rm -rf "$tmpdir"' EXIT
  sql_on "$sh" "$sp" "$su" "$sw" -Nse "CHECKSUM TABLE $qualified" > "$tmpdir/sc" 2>/dev/null || true
  sql_on "$th" "$tp" "$tu" "$tw" -Nse "CHECKSUM TABLE $qualified" > "$tmpdir/tc" 2>/dev/null || true
  sql_on "$sh" "$sp" "$su" "$sw" -Nse "$counts_sql" > "$tmpdir/sn" 2>/dev/null || true
  sql_on "$th" "$tp" "$tu" "$tw" -Nse "$counts_sql" > "$tmpdir/tn" 2>/dev/null || true

  {
    printf 'table\tsrc_rows\ttgt_rows\tsrc_checksum\ttgt_checksum\tmatch\n'
    while IFS= read -r t; do
      [ -n "$t" ] || continue
      sc=$(awk -F'\t' -v k="$db.$t" '$1==k {print $2}' "$tmpdir/sc"); [ -n "$sc" ] || sc="missing"
      tc=$(awk -F'\t' -v k="$db.$t" '$1==k {print $2}' "$tmpdir/tc"); [ -n "$tc" ] || tc="missing"
      sr=$(awk -F'\t' -v k="$t" '$1==k {print $2}' "$tmpdir/sn"); [ -n "$sr" ] || sr="-"
      tr=$(awk -F'\t' -v k="$t" '$1==k {print $2}' "$tmpdir/tn"); [ -n "$tr" ] || tr="-"
      if [ "$sc" = "$tc" ] && [ "$sr" = "$tr" ] && [ "$sc" != "missing" ]; then m="OK"; else m="DIFF"; fi
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$t" "$sr" "$tr" "$sc" "$tc" "$m"
    done <<< "$tbls"
  } | COLOR="$color" python3 "{{TABLE_PY}}"

# 환경 비교 진입점. 호스트 쌍을 한 번만 고르고, 무엇을 비교할지 반복해서 고른다.
# 개별 recipe(mysql-config-diff / -grants-diff / mysql-checksum)도 그대로 쓸 수 있다.
[group('mysql')]
mysql-diff:
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  {{MYSQL_CONNECT}}

  setup_conn "source host" || exit 0
  src_raw="$raw_line" src_label="$label"
  setup_conn "target host" || exit 0
  tgt_raw="$raw_line" tgt_label="$label"
  [ "$src_raw" != "$tgt_raw" ] || { echo "Source and target are the same host." >&2; exit 1; }

  echo ">> $src_label  vs  $tgt_label" >&2
  while true; do
    what=$(printf '%s\n' \
      "config    server variables (pt-config-diff)" \
      "grants    accounts and privileges" \
      "data      table data (CHECKSUM TABLE + row counts)" \
      "schema    DDL -- use the db-portal, percona-toolkit has no schema diff" \
      "quit" \
      | fzf --prompt="compare> " --height=40% --scheme=default) || break
    [ -n "$what" ] || break
    case "${what%% *}" in
      config) just --justfile "{{justfile()}}" mysql-config-diff "$src_raw" "$tgt_raw" || true ;;
      grants) just --justfile "{{justfile()}}" mysql-grants-diff "$src_raw" "$tgt_raw" || true ;;
      data)   just --justfile "{{justfile()}}" mysql-checksum "" "$src_raw" "$tgt_raw" || true ;;
      schema)
        # packages/schema-diff is a library with no CLI, so there is nothing to
        # shell out to -- point at the UI instead of half-reimplementing it here.
        echo "Schema diff lives in the db-portal (packages/schema-diff):" >&2
        echo "  cd ~/20_Work/01_Asurion/projects/db-portal && pnpm dev   ->  http://localhost:3000" >&2
        echo "It compares tables/columns/indexes/constraints/views/routines/triggers/" >&2
        echo "events/partitions with severity and generates the sync DDL." >&2 ;;
      quit|*) break ;;
    esac
    echo >&2
  done

# 두 환경의 권한 diff. 어느 계정/권한이 한쪽에만 있는지 바로 보인다.
[group('mysql')]
mysql-grants-diff source="" target="":
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  {{MYSQL_CONNECT}}

  setup_conn "source host" "{{source}}" || exit 0
  sh=$host sp=$port su=$user sw=$pw slabel=$label
  setup_conn "target host" "{{target}}" || exit 0
  th=$host tp=$port tu=$user tw=$pw tlabel=$label
  color=1; { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0

  # Temp 0600 defaults-files: --password would expose the password in ps output.
  d=$(mktemp -d); trap 'rm -rf "$d"' EXIT
  chmod 700 "$d"
  printf '[client]\npassword=%s\n' "$sw" > "$d/s.cnf"
  printf '[client]\npassword=%s\n' "$tw" > "$d/t.cnf"
  chmod 600 "$d/s.cnf" "$d/t.cnf"

  # ALTER USER lines carry the password hash and a long PASSWORD EXPIRE tail that
  # differs cosmetically between servers; keep only the account and DEFAULT ROLE.
  clean() {
    grep -vE '^(--|$)' \
      | sed -E "s/ IDENTIFIED WITH '[^']*'( AS '[^']*')?//; \
                s/ REQUIRE NONE.*//; s/ PASSWORD EXPIRE.*//" \
      | sort -u
  }
  pt-show-grants --defaults-file="$d/s.cnf" --host="$sh" --port="$sp" --user="$su" | clean > "$d/s.sql"
  pt-show-grants --defaults-file="$d/t.cnf" --host="$th" --port="$tp" --user="$tu" | clean > "$d/t.sql"

  [ -n "{{source}}" ] || echo ">> $slabel  vs  $tlabel" >&2

  # Accounts present on only one side.
  acct() { grep -oE '^CREATE (USER|ROLE)[^`]*`[^`]+`(@`[^`]+`)?' "$1" | sed -E 's/^CREATE (USER|ROLE) (IF NOT EXISTS )?//' | sort -u; }
  {
    printf 'account\tonly in\n'
    comm -23 <(acct "$d/s.sql") <(acct "$d/t.sql") | sed "s|\$|\t$slabel|"
    comm -13 <(acct "$d/s.sql") <(acct "$d/t.sql") | sed "s|\$|\t$tlabel|"
  } | COLOR="$color" python3 "{{TABLE_PY}}"

  # Grant statements present on only one side, boilerplate already stripped.
  echo "== statements only in $slabel ==" >&2
  comm -23 "$d/s.sql" "$d/t.sql" | grep -vE '^CREATE (USER|ROLE)' || true
  echo "== statements only in $tlabel ==" >&2
  comm -13 "$d/s.sql" "$d/t.sql" | grep -vE '^CREATE (USER|ROLE)' || true

# 두 환경의 서버 변수 diff (pt-config-diff).
[group('mysql')]
mysql-config-diff source="" target="":
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  {{MYSQL_CONNECT}}

  setup_conn "source host" "{{source}}" || exit 0
  sh=$host sp=$port su=$user sw=$pw slabel=$label
  setup_conn "target host" "{{target}}" || exit 0
  th=$host tp=$port tu=$user tw=$pw tlabel=$label

  cnf=$(mktemp); d_out=$(mktemp); chmod 600 "$cnf"
  trap 'rm -f "$cnf" "$d_out"' EXIT
  printf '[client]\npassword=%s\n' "$sw" > "$cnf"

  [ -n "{{source}}" ] || echo ">> $slabel  vs  $tlabel" >&2
  # pt-config-diff exits 1 when it finds differences, which is the normal outcome.
  # Without --ignore-variables every run reports the same four server-identity
  # differences, which buries the ones that actually matter.
  # --no-version-check: otherwise every run prints percona's "software updates are
  # available" block, which is the only output once the real diff is empty.
  pt-config-diff --defaults-file="$cnf" --no-version-check \
    --ignore-variables=hostname,server_id,server_uuid,aurora_server_id,report_host,aurora_version \
    "h=$sh,P=$sp,u=$su" "h=$th,P=$tp,u=$tu" > "$d_out" 2>&1 || true
  if [ -s "$d_out" ]; then cat "$d_out"; else echo "No differences (server identity variables ignored)."; fi

# Redshift / PostgreSQL

# 테이블이 어느 데이터베이스·스키마에 있는지 찾는다. Redshift 는 같은 이름의
# 데이터베이스와 스키마가 공존할 수 있어서(예: etldata) 트리에서 헷갈리기 쉽다.
# hint: name: 테이블명 (부분 일치)
[group('redshift')]
redshift-find-table name:
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  {{PG_CONNECT}}
  PGQ_PYTHON="{{PGQ_PYTHON}}"; PGQ_PY="{{PGQ_PY}}"
  setup_pg || exit 0
  color=1; { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0
  pgq "SELECT database_name, schema_name, table_name, table_type
       FROM svv_all_tables WHERE table_name ILIKE %s ORDER BY 1,2,3" "%{{name}}%" \
    | COLOR="$color" python3 "{{TABLE_PY}}"

# 유저가 가진 role 과 그 role 의 권한. Redshift 는 RBAC role 과 구식 group 이
# 따로라서 pg_user/pg_group 만 보는 \du 로는 안 보인다.
# hint: user: 대상 유저 (비우면 fzf)
[group('redshift')]
redshift-grants user="":
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  {{PG_CONNECT}}
  PGQ_PYTHON="{{PGQ_PYTHON}}"; PGQ_PY="{{PGQ_PY}}"
  {{DDB_PICK}}
  setup_pg || exit 0
  color=1; { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0

  u="{{user}}"
  if [ -z "$u" ]; then
    u=$(pgq "SELECT usename FROM pg_user ORDER BY 1" | tail -n +2 | pick_or_type "user")
    [ -n "$u" ] || exit 0
  fi

  echo "== roles granted to $u ==" >&2
  pgq "SELECT role_name, admin_option FROM svv_user_grants WHERE user_name = %s ORDER BY 1" "$u" \
    | COLOR="$color" python3 "{{TABLE_PY}}"

  echo "== groups (legacy) ==" >&2
  pgq "SELECT g.groname FROM pg_group g JOIN pg_user pu ON pu.usesysid = ANY(g.grolist)
       WHERE pu.usename = %s ORDER BY 1" "$u" \
    | COLOR="$color" python3 "{{TABLE_PY}}"

  echo "== schema privileges via those roles ==" >&2
  pgq "SELECT identity_name AS role, namespace_name AS schema, privilege_type
       FROM svv_schema_privileges
       WHERE identity_type = 'role'
         AND identity_name IN (SELECT role_name FROM svv_user_grants WHERE user_name = %s)
       ORDER BY 1,2,3" "$u" \
    | COLOR="$color" python3 "{{TABLE_PY}}"

  # 508 relation rows for one role is normal, so summarise instead of listing.
  echo "== relation privileges, grouped ==" >&2
  pgq "SELECT identity_name AS role, namespace_name AS schema, privilege_type,
              COUNT(*) AS objects
       FROM svv_relation_privileges
       WHERE identity_type = 'role'
         AND identity_name IN (SELECT role_name FROM svv_user_grants WHERE user_name = %s)
       GROUP BY 1,2,3 ORDER BY 4 DESC" "$u" \
    | COLOR="$color" python3 "{{TABLE_PY}}"

  echo "== system privileges ==" >&2
  pgq "SELECT identity_name AS role, system_privilege
       FROM svv_system_privileges
       WHERE identity_type = 'role'
         AND identity_name IN (SELECT role_name FROM svv_user_grants WHERE user_name = %s)
       ORDER BY 1,2" "$u" \
    | COLOR="$color" python3 "{{TABLE_PY}}"

# 테이블 크기와 정리 상태. unsorted/stats_off 가 높으면 VACUUM/ANALYZE 대상.
# hint: schema: 특정 스키마만 (비우면 전체)
# hint: top: 보여줄 테이블 수 (default: 25)
[group('redshift')]
redshift-tables schema="" top="25":
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  {{PG_CONNECT}}
  PGQ_PYTHON="{{PGQ_PYTHON}}"; PGQ_PY="{{PGQ_PY}}"
  setup_pg || exit 0
  color=1; { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0
  pgq "SELECT \"schema\", \"table\", tbl_rows AS rows, size AS mb,
              ROUND(pct_used, 1) AS pct_used, ROUND(unsorted, 1) AS unsorted_pct,
              ROUND(stats_off, 1) AS stats_off, diststyle, sortkey1
       FROM svv_table_info
       WHERE (%s = '' OR \"schema\" = %s)
       ORDER BY size DESC LIMIT {{top}}" "{{schema}}" "{{schema}}" \
    | COLOR="$color" CELL=28 python3 "{{TABLE_PY}}"

# 지금 돌고 있는 쿼리와 WLM 상태.
[group('redshift')]
redshift-sessions:
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  {{PG_CONNECT}}
  PGQ_PYTHON="{{PGQ_PYTHON}}"; PGQ_PY="{{PGQ_PY}}"
  setup_pg || exit 0
  color=1; { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0

  echo "== running (stv_recents) ==" >&2
  pgq "SELECT user_name, status, duration, pid, query
       FROM stv_recents WHERE status = 'Running' ORDER BY duration DESC" \
    | COLOR="$color" CELL=70 python3 "{{TABLE_PY}}"

  echo "== WLM queue ==" >&2
  pgq "SELECT service_class, state, COUNT(*) AS queries
       FROM stv_wlm_query_state GROUP BY 1,2 ORDER BY 1,2" \
    | COLOR="$color" python3 "{{TABLE_PY}}"

  echo "== disk (stv_partitions) ==" >&2
  pgq "SELECT SUM(capacity) AS capacity_mb, SUM(used) AS used_mb,
              ROUND(100.0 * SUM(used) / NULLIF(SUM(capacity), 0), 1) AS pct
       FROM stv_partitions WHERE part_begin = 0" \
    | COLOR="$color" python3 "{{TABLE_PY}}"

# 최근 느린 쿼리 (stl_query). Redshift 에는 performance_schema 가 없다.
# hint: hours: 최근 N시간 (default: 24)
# hint: top: 보여줄 쿼리 수 (default: 20)
[group('redshift')]
redshift-slow hours="24" top="20":
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  {{PG_CONNECT}}
  PGQ_PYTHON="{{PGQ_PYTHON}}"; PGQ_PY="{{PGQ_PY}}"
  setup_pg || exit 0
  color=1; { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0
  pgq "SELECT q.query, TRIM(u.usename) AS user, q.starttime,
              DATEDIFF(ms, q.starttime, q.endtime) AS ms, q.aborted, TRIM(q.querytxt) AS querytxt
       FROM stl_query q LEFT JOIN pg_user u ON u.usesysid = q.userid
       WHERE q.starttime > GETDATE() - INTERVAL '{{hours}} hours'
       ORDER BY ms DESC LIMIT {{top}}" \
    | COLOR="$color" CELL=70 python3 "{{TABLE_PY}}"

# DynamoDB

# 테이블 목록. 기본은 이름만(빠름), detail=true 면 건수/용량/과금모드까지.
# hint: detail: true 면 테이블마다 describe-table 을 호출한다 (71개 기준 ~15초)
[group('dynamodb')]
ddb-list detail="false":
  #!/usr/bin/env bash
  set -euo pipefail
  color=1
  { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0

  if [ "{{detail}}" != "true" ]; then
    # column(1)/pr(1) pad with tabs here, which renders unevenly; lay the names
    # out column-major with explicit padding instead. COLUMNS is a shell variable
    # and is not exported into the recipe, so ask the terminal directly.
    width=$(tput cols 2>/dev/null || echo 100)
    {{DDB_TABLES}} | awk -v W="$width" '
      { a[NR] = $0; if (length($0) > m) m = length($0) }
      END {
        c = int(W / (m + 2)); if (c < 1) c = 1
        r = int((NR + c - 1) / c)
        for (i = 1; i <= r; i++) {
          line = ""
          for (j = 0; j < c; j++) { k = i + j * r; if (k <= NR) line = line sprintf("%-*s", m + 2, a[k]) }
          sub(/ +$/, "", line); print line
        }
      }'
    exit 0
  fi

  # One describe-table per table, 8 at a time -- sequential takes about 4x longer.
  echo ">> reading $( {{DDB_TABLES}} | grep -c . ) tables..." >&2
  {
    printf 'table\titems\tsize\tmode\n'
    {{DDB_TABLES}} | xargs -P8 -I@ aws dynamodb describe-table --table-name @ \
      --query "Table.[TableName,ItemCount,TableSizeBytes,ProvisionedThroughput.ReadCapacityUnits]" \
      --output text \
      | sort \
      | awk -F'\t' '{
          n = $2; s = $3
          out = ""
          while (length(n) > 3) { out = "," substr(n, length(n) - 2) out; n = substr(n, 1, length(n) - 3) }
          items = n out
          if (s >= 1073741824)   size = sprintf("%.1f GB", s / 1073741824)
          else if (s >= 1048576) size = sprintf("%.1f MB", s / 1048576)
          else if (s >= 1024)    size = sprintf("%.1f KB", s / 1024)
          else                   size = s " B"
          printf "%s\t%s\t%s\t%s\n", $1, items, size, ($4 > 0 ? "PROVISIONED" : "PAY_PER_REQUEST")
        }'
  } | COLOR="$color" python3 "{{TABLE_PY}}"

# hint: table: 조회할 테이블 (비우면 fzf로 선택)
# hint: full: true 면 describe-table 원문 JSON; 기본은 키/인덱스/건수/용량 요약
[group('dynamodb')]
ddb-describe table="" full="false":
  #!/usr/bin/env bash
  set -euo pipefail
  {{DDB_PICK}}
  tbl="{{table}}"
  [ -n "$tbl" ] || tbl=$({{DDB_TABLES}} | pick_or_type "table")
  [ -n "$tbl" ] || exit 0
  raw=$(aws dynamodb describe-table --table-name "$tbl" --output json)
  # TTL lives behind its own API. Tolerate failure (e.g. missing permission) --
  # the ttl row is simply omitted rather than taking the whole recipe down.
  ttl=$(aws dynamodb describe-time-to-live --table-name "$tbl" --output json 2>/dev/null || printf '{}')
  raw=$(jq -n --argjson a "$raw" --argjson b "$ttl" '$a + $b')
  if [ "{{full}}" = "true" ]; then
    printf '%s\n' "$raw" | jq '.'
    exit 0
  fi
  # Colour only for a terminal, and honour NO_COLOR; redirected output stays plain.
  color=1
  { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0
  printf '%s\n' "$raw" | jq -r '{{DDB_RECORDS_JQ}}' | awk -v COLOR="$color" '{{DDB_BOX_AWK}}'

# 정확한 row 수 (전체 scan). describe-table 의 근사치를 먼저 보여주고 확인을 받는다.
# hint: table: 조회할 테이블 (비우면 fzf로 선택)
[group('dynamodb')]
ddb-count table="":
  #!/usr/bin/env bash
  set -euo pipefail
  {{DDB_PICK}}
  tbl="{{table}}"
  [ -n "$tbl" ] || tbl=$({{DDB_TABLES}} | pick_or_type "table")
  [ -n "$tbl" ] || exit 0

  # ItemCount is free (refreshed roughly every 6 hours) and is usually enough.
  info=$(aws dynamodb describe-table --table-name "$tbl" --output json)
  approx=$(printf '%s' "$info" | jq -r '.Table.ItemCount')
  bytes=$(printf '%s' "$info" | jq -r '.Table.TableSizeBytes')
  rcu=$(printf '%s' "$info" | jq -r '.Table.ProvisionedThroughput.ReadCapacityUnits // 0')
  echo "$tbl: ~$approx items, $bytes bytes  (describe-table, ~6h old)"

  # A full scan reads every item. On a PROVISIONED table that easily exceeds the
  # configured RCU and the CLI gives up mid-way -- which is how this recipe used
  # to report a wrong number.
  # Rough cost: a scan reads the whole table, and one RCU covers 8 KB/s of
  # eventually-consistent reads. Warn only when that runs long enough to matter,
  # so a tiny provisioned table does not nag.
  if [ "$rcu" != "0" ]; then
    est=$(( bytes / (rcu * 8192 + 1) ))
    if [ "$est" -ge 10 ]; then
      echo "WARNING: PROVISIONED rcu=$rcu -- scanning $bytes bytes takes ~${est}s at full read capacity and will likely be throttled." >&2
    fi
  fi
  printf 'Run a full scan of %s for the exact count? [y/N] ' "$tbl"
  read -r reply || reply=""
  case "$reply" in y|Y|yes|YES) ;; *) echo "Skipped the scan."; exit 0 ;; esac

  # The CLI paginates and applies --query per page, so --output text prints one
  # Count per page. Summing is required; printing them raw (as this recipe did)
  # showed several partial numbers instead of a total.
  total=$(aws dynamodb scan --table-name "$tbl" --select COUNT --query "Count" --output text \
    | awk '{s += $1} END {print s + 0}')
  echo "Count: $total"

# 앞쪽 N건만 훑어보기 (키를 몰라도 됨)
# hint: table: 조회할 테이블 (비우면 fzf로 선택)
# hint: limit: 가져올 최대 항목 수 (default: 20)
# hint: cols: 표에 넣을 속성 (콤마 구분, 비우면 앞 6개)
# hint: full: true 면 원문 JSON
[group('dynamodb')]
ddb-scan table="" limit="20" cols="" full="false":
  #!/usr/bin/env bash
  set -euo pipefail
  {{DDB_PICK}}
  tbl="{{table}}"
  [ -n "$tbl" ] || tbl=$({{DDB_TABLES}} | pick_or_type "table")
  [ -n "$tbl" ] || exit 0
  # --limit (API-side) rather than --max-items (CLI-side): --max-items truncates
  # the printed items but leaves Count reporting the untruncated page, and adds a
  # NextToken line.
  out=$(aws dynamodb scan --table-name "$tbl" --limit "{{limit}}" --output json)
  if [ "{{full}}" = "true" ]; then
    printf '%s\n' "$out" | jq '.'
    exit 0
  fi
  color=1
  { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0
  printf '%s\n' "$out" \
    | jq -r --arg COLS "{{cols}}" --argjson MAXC 6 --argjson W 999 '{{DDB_ITEMS_JQ}}' \
    | COLOR="$color" CELL=24 python3 "{{TABLE_PY}}"

# 키로 조회. 테이블의 키 스키마를 읽어 --key-condition-expression 과
# --expression-attribute-names/values 를 대신 만들어 준다. 인덱스도 골라서 쓸 수 있다.
# hint: table: 조회할 테이블 (비우면 fzf로 선택)
# hint: index: 사용할 인덱스 (비우면 fzf: 기본 테이블 / GSI / LSI 중 선택)
# hint: pk: 파티션 키 값 (비우면 입력 프롬프트)
# hint: sk: 정렬 키 값 (비우면 파티션 키만으로 조회)
# hint: limit: 가져올 최대 항목 수 (default: 20)
# hint: cols: 표에 넣을 속성 (콤마 구분, 비우면 앞 6개)
# hint: full: true 면 원문 JSON
[group('dynamodb')]
ddb-query table="" index="" pk="" sk="" limit="20" cols="" full="false":
  #!/usr/bin/env bash
  set -euo pipefail
  {{DDB_PICK}}
  base_marker="(base table)"

  tbl="{{table}}"
  [ -n "$tbl" ] || tbl=$({{DDB_TABLES}} | pick_or_type "table")
  [ -n "$tbl" ] || exit 0

  # One describe-table call supplies both the index list and every key schema.
  schema=$(aws dynamodb describe-table --table-name "$tbl" --output json)

  idx="{{index}}"
  if [ -z "$idx" ]; then
    idx_list=$(printf '%s' "$schema" | jq -r '
      ((.Table.GlobalSecondaryIndexes // []) + (.Table.LocalSecondaryIndexes // []))
      | .[].IndexName')
    if [ -n "$idx_list" ]; then
      idx=$(printf '%s\n%s\n' "$base_marker" "$idx_list" | pick_or_type "index")
      [ -n "$idx" ] || exit 0
    else
      idx="$base_marker"
    fi
  fi

  if [ "$idx" = "$base_marker" ]; then
    keys=$(printf '%s' "$schema" | jq -c '.Table.KeySchema')
  else
    keys=$(printf '%s' "$schema" | jq -c --arg i "$idx" '
      ((.Table.GlobalSecondaryIndexes // []) + (.Table.LocalSecondaryIndexes // []))
      | map(select(.IndexName == $i)) | .[0].KeySchema // empty')
    [ -n "$keys" ] || { echo "No such index on $tbl: $idx" >&2; exit 1; }
  fi

  pk_name=$(printf '%s' "$keys" | jq -r '.[] | select(.KeyType=="HASH")  | .AttributeName')
  sk_name=$(printf '%s' "$keys" | jq -r '.[] | select(.KeyType=="RANGE") | .AttributeName' )
  attr_type() {
    printf '%s' "$schema" | jq -r --arg n "$1" \
      '.Table.AttributeDefinitions[] | select(.AttributeName==$n) | .AttributeType'
  }

  # Prompt only with a terminal on stdin. Without the [ -t 0 ] guard a piped or
  # redirected run hits EOF, `read` returns non-zero, and set -e kills the recipe
  # with no message -- so passing sk="" to mean "skip" did not work.
  pkv="{{pk}}"
  if [ -z "$pkv" ] && [ -t 0 ]; then
    read -rp "$pk_name (partition key, type $(attr_type "$pk_name")): " pkv || pkv=""
  fi
  [ -n "$pkv" ] || { echo "Partition key value is required (3rd argument: pk)" >&2; exit 1; }

  skv="{{sk}}"
  if [ -z "$skv" ] && [ -n "$sk_name" ] && [ -t 0 ]; then
    read -rp "$sk_name (sort key, type $(attr_type "$sk_name"), empty = skip): " skv || skv=""
  fi

  # #aliases avoid clashing with DynamoDB reserved words (name, status, id...).
  cond='#pk = :pk'
  names=$(jq -n --arg pn "$pk_name" '{"#pk": $pn}')
  vals=$(jq -n --arg v "$pkv" --arg t "$(attr_type "$pk_name")" '{":pk": {($t): $v}}')
  if [ -n "$skv" ]; then
    cond='#pk = :pk AND #sk = :sk'
    names=$(printf '%s' "$names" | jq --arg sn "$sk_name" '. + {"#sk": $sn}')
    vals=$(printf '%s' "$vals" | jq --arg v "$skv" --arg t "$(attr_type "$sk_name")" '. + {":sk": {($t): $v}}')
  fi

  args=(
    --table-name "$tbl"
    --key-condition-expression "$cond"
    --expression-attribute-names "$names"
    --expression-attribute-values "$vals"
    --limit "{{limit}}"
  )
  [ "$idx" = "$base_marker" ] || args+=(--index-name "$idx")

  if [ "$idx" = "$base_marker" ]; then label="$tbl"; else label="$tbl [$idx]"; fi
  echo ">> query $label: $cond" >&2
  out=$(aws dynamodb query "${args[@]}" --output json)
  if [ "{{full}}" = "true" ]; then
    printf '%s\n' "$out" | jq '.'
    exit 0
  fi
  color=1
  { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0
  printf '%s\n' "$out" \
    | jq -r --arg COLS "{{cols}}" --argjson MAXC 6 --argjson W 999 '{{DDB_ITEMS_JQ}}' \
    | COLOR="$color" CELL=24 python3 "{{TABLE_PY}}"

# 용량 모드 / RCU·WCU 조회 및 변경. rcu=1 짜리 테이블을 전체 scan 하면
# ProvisionedThroughputExceededException 이 나는데, 그때 여기서 바꾼다.
# hint: table: 대상 테이블 (비우면 fzf)
# hint: mode: 비우면 조회만. ondemand | rcu:wcu (예: 25:5)
[group('dynamodb')]
ddb-capacity table="" mode="":
  #!/usr/bin/env bash
  set -euo pipefail
  {{DDB_PICK}}
  tbl="{{table}}"
  [ -n "$tbl" ] || tbl=$({{DDB_TABLES}} | pick_or_type "table")
  [ -n "$tbl" ] || exit 0
  color=1; { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0

  show() {
    aws dynamodb describe-table --table-name "$1" --output json \
      | jq -r '.Table as $t
          | ["table\tmode\trcu\twcu\tsize\titems",
             "\($t.TableName)\t" +
             (if ($t.ProvisionedThroughput.ReadCapacityUnits // 0) > 0 then "PROVISIONED" else "PAY_PER_REQUEST" end) +
             "\t\($t.ProvisionedThroughput.ReadCapacityUnits // 0)\t\($t.ProvisionedThroughput.WriteCapacityUnits // 0)" +
             "\t\($t.TableSizeBytes)\t\($t.ItemCount)"] | .[]' \
      | COLOR="$color" python3 "{{TABLE_PY}}"
  }
  show "$tbl"
  [ -n "{{mode}}" ] || exit 0

  case "{{mode}}" in
    ondemand|PAY_PER_REQUEST) args=(--billing-mode PAY_PER_REQUEST); desc="PAY_PER_REQUEST" ;;
    *:*) r=${mode%%:*}; w=${mode##*:}
         args=(--billing-mode PROVISIONED --provisioned-throughput "ReadCapacityUnits=$r,WriteCapacityUnits=$w")
         desc="PROVISIONED rcu=$r wcu=$w" ;;
    *) echo "mode must be 'ondemand' or 'rcu:wcu' (e.g. 25:5)" >&2; exit 1 ;;
  esac
  # Switching to on-demand is limited to once per 24 hours per table, so make the
  # change deliberate rather than a side effect of running the recipe.
  printf 'Change %s to %s? [y/N] ' "$tbl" "$desc"
  read -r reply || reply=""
  case "$reply" in y|Y|yes|YES) ;; *) echo "Aborted."; exit 1 ;; esac
  aws dynamodb update-table --table-name "$tbl" "${args[@]}" --output json | jq -r '.TableDescription.TableStatus'
  echo ">> update requested; the table stays UPDATING for a while." >&2

# TTL 조회 및 켜기/끄기.
# hint: table: 대상 테이블 (비우면 fzf)
# hint: attribute: 켤 때 쓸 속성명 (비우면 조회만)
# hint: disable: true 면 TTL 끄기
[group('dynamodb')]
ddb-ttl table="" attribute="" disable="false":
  #!/usr/bin/env bash
  set -euo pipefail
  {{DDB_PICK}}
  tbl="{{table}}"
  [ -n "$tbl" ] || tbl=$({{DDB_TABLES}} | pick_or_type "table")
  [ -n "$tbl" ] || exit 0

  cur=$(aws dynamodb describe-time-to-live --table-name "$tbl" \
    --query 'TimeToLiveDescription.[TimeToLiveStatus,AttributeName]' --output text)
  echo "$tbl: $cur" >&2

  if [ "{{disable}}" = "true" ]; then
    # Disabling still requires the attribute name that TTL is currently using.
    attr=$(printf '%s' "$cur" | awk '{print $2}')
    [ -n "$attr" ] && [ "$attr" != "None" ] || { echo "TTL is not enabled, nothing to disable." >&2; exit 0; }
    spec="Enabled=false,AttributeName=$attr"; desc="disable TTL ($attr)"
  elif [ -n "{{attribute}}" ]; then
    spec="Enabled=true,AttributeName={{attribute}}"; desc="enable TTL on {{attribute}}"
  else
    exit 0
  fi

  printf '%s for %s? [y/N] ' "$desc" "$tbl"
  read -r reply || reply=""
  case "$reply" in y|Y|yes|YES) ;; *) echo "Aborted."; exit 1 ;; esac
  aws dynamodb update-time-to-live --table-name "$tbl" \
    --time-to-live-specification "$spec" --output json | jq -r '.TimeToLiveSpecification'

# PITR 기반 S3 export. 읽기 용량을 전혀 쓰지 않아서 대용량 PROD 테이블을
# 세거나 백업할 때 scan 대신 쓴다. PITR 이 켜져 있어야 한다.
# hint: table: 대상 테이블 (비우면 fzf)
# hint: bucket: 대상 S3 버킷 (비우면 fzf)
# hint: prefix: S3 prefix (default: dynamodb_exports/<table>/)
[group('dynamodb')]
ddb-export table="" bucket="" prefix="":
  #!/usr/bin/env bash
  set -euo pipefail
  {{DDB_PICK}}
  tbl="{{table}}"
  [ -n "$tbl" ] || tbl=$({{DDB_TABLES}} | pick_or_type "table")
  [ -n "$tbl" ] || exit 0

  pitr=$(aws dynamodb describe-continuous-backups --table-name "$tbl" \
    --query 'ContinuousBackupsDescription.PointInTimeRecoveryDescription.PointInTimeRecoveryStatus' \
    --output text 2>/dev/null || echo UNKNOWN)
  echo "$tbl: PITR $pitr" >&2
  [ "$pitr" = "ENABLED" ] || { echo "export-table-to-point-in-time needs PITR enabled." >&2; exit 1; }

  bkt="{{bucket}}"
  [ -n "$bkt" ] || bkt=$(aws s3 ls | awk '{print $3}' | sort | pick_or_type "s3 bucket")
  [ -n "$bkt" ] || exit 0
  pfx="{{prefix}}"; [ -n "$pfx" ] || pfx="dynamodb_exports/$tbl/"

  arn=$(aws dynamodb describe-table --table-name "$tbl" --query 'Table.TableArn' --output text)
  printf 'Export %s to s3://%s/%s ? [y/N] ' "$tbl" "$bkt" "$pfx"
  read -r reply || reply=""
  case "$reply" in y|Y|yes|YES) ;; *) echo "Aborted."; exit 1 ;; esac

  out=$(aws dynamodb export-table-to-point-in-time --table-arn "$arn" \
    --s3-bucket "$bkt" --s3-prefix "$pfx" --export-format DYNAMODB_JSON --output json)
  printf '%s\n' "$out" | jq -r '.ExportDescription | "status: \(.ExportStatus)\narn:    \(.ExportArn)"'
  echo ">> manifest-summary.json under the prefix carries the exact itemCount once done." >&2

# YAML 설정으로 테이블 생성. 플래그 없이 실행하면 명령만 출력한다(dry-run).
# create/*.yaml 이 두 가지 스키마로 섞여 있어서, table_name 이면 dynamodb_builder,
# base_name+environments 면 multi_env_deploy 로 보낸다.
# hint: config: YAML 경로 (비우면 create/*.yaml 중 fzf)
# hint: env: 환경 목록 (콤마 구분). builder 는 DEV,SQA / multi_env 는 Dev,Sqa 표기
# hint: execute: true 면 실제 생성
[group('dynamodb')]
ddb-create config="" env="" execute="false":
  #!/usr/bin/env bash
  set -euo pipefail
  {{DDB_PICK}}
  dir="{{DDB_SCRIPT_DIR}}/create"
  cfg="{{config}}"
  if [ -z "$cfg" ]; then
    cfg=$(find "$dir" -maxdepth 1 -name '*.yaml' | sort | pick_or_type "config")
    [ -n "$cfg" ] || exit 0
  fi
  [ -f "$cfg" ] || { echo "No such config: $cfg" >&2; exit 1; }

  # One line: a recipe body cannot contain lines starting at column 0, which is
  # what a multi-line python -c string would produce.
  kind=$(python3 -c "import yaml,sys; c=yaml.safe_load(open(sys.argv[1])) or {}; print('builder' if 'table_name' in c else 'multienv' if 'base_name' in c else 'unknown')" "$cfg")
  echo ">> $(basename "$cfg"): $kind schema" >&2

  args=()
  [ "{{execute}}" = "true" ] && args+=(--execute)
  case "$kind" in
    builder)
      [ -n "{{env}}" ] && args+=(--env "{{env}}")
      python3 "$dir/dynamodb_builder.py" "$cfg" ${args[@]+"${args[@]}"} ;;
    multienv)
      name=$(python3 -c "import yaml,sys; print(yaml.safe_load(open(sys.argv[1]))['base_name'])" "$cfg")
      [ -n "{{env}}" ] && args+=(--env "{{env}}")
      python3 "$dir/multi_env_deploy.py" --name "$name" ${args[@]+"${args[@]}"} ;;
    *)
      echo "Config has neither table_name nor base_name; cannot tell which tool it is for." >&2
      exit 1 ;;
  esac
  [ "{{execute}}" = "true" ] || echo ">> dry-run only. Pass execute=true to create." >&2

# hint: source_table: 복사할 원본 테이블 (비우면 fzf로 선택)
# hint: new_table: 새 테이블 이름 (비우면 환경 접미사를 바꾼 후보를 제시)
[group('dynamodb')]
ddb-copy source_table="" new_table="":
  #!/usr/bin/env bash
  set -euo pipefail
  {{DDB_PICK}}
  src="{{source_table}}"
  [ -n "$src" ] || src=$({{DDB_TABLES}} | pick_or_type "source table")
  [ -n "$src" ] || exit 0
  dst="{{new_table}}"
  [ -n "$dst" ] || dst=$(just --justfile "{{justfile()}}" _ddb-suggest "$src" | pick_or_type "new table")
  [ -n "$dst" ] || exit 0

  # Confirmed here rather than with [confirm]: that attribute runs before the
  # body, when the names picked below are not known yet.
  printf 'Create %s as a schema copy of %s? [y/N] ' "$dst" "$src"
  read -r reply || reply=""
  case "$reply" in y|Y|yes|YES) ;; *) echo "Aborted."; exit 1 ;; esac

  python3 "{{DDB_SCRIPT_DIR}}/create/copy_table.py" "$src" "$dst" --execute

# hint: source_table: 복사할 원본 테이블 (비우면 fzf로 선택)
# hint: new_table: 새 테이블 이름 (비우면 환경 접미사를 바꾼 후보를 제시)
# hint: limit: 복사할 최대 항목 수 (비우면 선택: 전체 / 100 / 1000 / 10000)
[group('dynamodb')]
ddb-copy-data source_table="" new_table="" limit="":
  #!/usr/bin/env bash
  set -euo pipefail
  {{DDB_PICK}}
  src="{{source_table}}"
  [ -n "$src" ] || src=$({{DDB_TABLES}} | pick_or_type "source table")
  [ -n "$src" ] || exit 0
  dst="{{new_table}}"
  [ -n "$dst" ] || dst=$(just --justfile "{{justfile()}}" _ddb-suggest "$src" | pick_or_type "new table")
  [ -n "$dst" ] || exit 0

  all_marker="(all items)"
  lim="{{limit}}"
  if [ -z "$lim" ]; then
    lim=$(printf '%s\n' "$all_marker" 100 1000 10000 100000 | pick_or_type "limit")
    [ -n "$lim" ] || exit 0
    [ "$lim" = "$all_marker" ] && lim=""
  fi

  printf 'Create %s from %s with %s? [y/N] ' "$dst" "$src" "${lim:-all items}"
  read -r reply || reply=""
  case "$reply" in y|Y|yes|YES) ;; *) echo "Aborted."; exit 1 ;; esac

  if [ -n "$lim" ]; then
    python3 "{{DDB_SCRIPT_DIR}}/create/copy_table.py" "$src" "$dst" --data --limit "$lim"
  else
    python3 "{{DDB_SCRIPT_DIR}}/create/copy_table.py" "$src" "$dst" --data
  fi

# Candidate names for ddb-copy: the same base name with the environment suffix
# swapped, keeping the source's capitalisation (BreachAuditDev -> BreachAuditSqa,
# GenAIChatDEV -> GenAIChatSQA). Names that already exist are dropped, since both
# copy recipes create a new table. Private: it only prints candidates.
[private]
_ddb-suggest name:
  #!/usr/bin/env bash
  set -euo pipefail
  n="{{name}}"
  existing=$({{DDB_TABLES}})
  emit() { printf '%s\n' "$1" | grep -qxF -f <(printf '%s\n' "$existing") || printf '%s\n' "$1"; }

  # Longest suffixes first so "...Prod" is not matched as "...rod".
  for suf in PROD Prod prod STG Stg stg UAT Uat uat SQA Sqa sqa DEV Dev dev; do
    case "$n" in
      *"$suf")
        base="${n%"$suf"}"
        for e in DEV SQA UAT STG PROD; do
          case "$suf" in
            [A-Z][A-Z]*) out="$base$e" ;;
            [A-Z]*)      out="$base$(printf '%s' "$e" | cut -c1)$(printf '%s' "$e" | cut -c2- | tr 'A-Z' 'a-z')" ;;
            *)           out="$base$(printf '%s' "$e" | tr 'A-Z' 'a-z')" ;;
          esac
          [ "$out" = "$n" ] || emit "$out"
        done
        exit 0 ;;
    esac
  done
  # No environment suffix to swap: offer the common shapes instead.
  for e in Copy DEV SQA UAT; do emit "$n$e"; done


# sysbench

# hint: threads: concurrent threads (default: 4)
# hint: time: test duration in seconds (default: 60)
# hint: tables: number of test tables (default: 4)
# hint: table_size: rows per table (default: 100000)
# hint: db: target database/schema (default: sbtest)
[group('sysbench')]
sysbench-prepare threads="4" tables="4" table_size="100000" db="sbtest":
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  selected=$(grep -v '^#' "$HOSTS_FILE" | grep -v '^$' | \
    fzf --prompt="sysbench host> " --height=40% --scheme=default)
  [ -z "$selected" ] && exit 0
  host=$(echo "$selected" | cut -d: -f2)
  port=$(echo "$selected" | cut -d: -f3)
  user=$(echo "$selected" | cut -d: -f4)
  echo ">> prepare on $host (db={{db}}, tables={{tables}}, rows={{table_size}})"
  sysbench oltp_read_write \
    --db-driver=mysql \
    --mysql-host="$host" \
    --mysql-port="$port" \
    --mysql-user="$user" \
    --mysql-password \
    --mysql-db="{{db}}" \
    --tables={{tables}} \
    --table-size={{table_size}} \
    --threads={{threads}} \
    prepare

