# AWS RDS

# aws-rds-list:
#   python3 "$HOME/.config/mysql/rds_table.py" clusters

# RDS 인스턴스 / Aurora 클러스터 목록.
# 이전 버전은 rds_table.py 에 아무 입력도 주지 않아 stdin 을 기다리다 멈추거나
# JSONDecodeError 로 죽었다. 이제 조회까지 recipe 안에서 한다.
# hint: what: instances (default) | clusters
[group('aws')]
aws-rds-list what="instances":
  #!/usr/bin/env bash
  set -euo pipefail
  color=1; { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0

  if [ "{{what}}" = "clusters" ]; then
    {
      # No endpoint column: its first label is just the cluster id again. Backup
      # retention and the exported log types are what actually differ per cluster.
      printf 'cluster\tstatus\tengine\tmembers\tbackup_days\tcw_logs\n'
      aws rds describe-db-clusters --output text --query \
        'sort_by(DBClusters, &DBClusterIdentifier)[*].[DBClusterIdentifier,Status,EngineVersion,length(DBClusterMembers),BackupRetentionPeriod,join(`,`, EnabledCloudwatchLogsExports || [`-`])]'
    } | COLOR="$color" python3 "{{TABLE_PY}}"
  else
    {
      printf 'cluster\tinstance\tclass\tstatus\tengine\taz\n'
      aws rds describe-db-instances --output text --query \
        'sort_by(DBInstances, &DBInstanceIdentifier)[*].[DBClusterIdentifier,DBInstanceIdentifier,DBInstanceClass,DBInstanceStatus,EngineVersion,AvailabilityZone]'
    } | COLOR="$color" python3 "{{TABLE_PY}}"
  fi

# hint: pg: cluster parameter group name (e.g. webfulfillment-mdb-prod-80-cg)
# hint: region: AWS region (default: ap-northeast-2)
#
# Zero-ETL (Aurora MySQL -> Redshift) 필수 cluster 파라미터 세팅.
# aurora_enhanced_binlog / binlog_backup / binlog_replication_globaldb 는 static ->
# 적용하려면 writer 인스턴스 재부팅 필요. AWS_PROFILE 을 미리 export 해두고 실행.

[group('aws')]
[confirm("Modify RDS parameter group " + pg + " in " + region + "?")]
rds-zeroetl-params pg region="ap-northeast-2":
  #!/usr/bin/env bash
  set -euo pipefail
  echo ">> Applying zero-ETL cluster params to: {{pg}} ({{region}})"
  aws rds modify-db-cluster-parameter-group \
    --region "{{region}}" \
    --db-cluster-parameter-group-name "{{pg}}" \
    --parameters \
      "ParameterName=aurora_enhanced_binlog,ParameterValue=1,ApplyMethod=pending-reboot" \
      "ParameterName=binlog_backup,ParameterValue=0,ApplyMethod=pending-reboot" \
      "ParameterName=binlog_replication_globaldb,ParameterValue=0,ApplyMethod=pending-reboot" \
      "ParameterName=binlog_format,ParameterValue=ROW,ApplyMethod=pending-reboot" \
      "ParameterName=binlog_row_image,ParameterValue=full,ApplyMethod=immediate" \
      "ParameterName=binlog_row_metadata,ParameterValue=full,ApplyMethod=immediate"
  echo ""
  echo "Done. static 파라미터 3개는 writer 재부팅 후 적용됩니다:"
  echo "  aws rds reboot-db-instance --region {{region}} --db-instance-identifier <writer-instance>"

# Aurora/RDS user migration

# hint: input_sql: raw SQL from pt-show-grants
# hint: output_sql: sanitized output file for Aurora/RDS

[group('mysql')]
mysql-sanitize-users input_sql="users_raw.sql" output_sql="users_sanitized.sql":
  #!/usr/bin/env bash
  set -euo pipefail
  python3 "{{SANITIZE_SCRIPT}}" "{{input_sql}}" "{{output_sql}}"
  echo "Written: {{output_sql}}"

# hint: input_sql: sanitized SQL to validate before import

[group('mysql')]
mysql-check-users input_sql="users_sanitized.sql":
  #!/usr/bin/env bash
  set -euo pipefail
  echo "== internal/system accounts =="
  grep -nE 'rdsadmin|mysql\.session|mysql\.sys|mysql\.infoschema|rds_superuser_role' "{{input_sql}}" || echo "  (none)"
  echo ""
  echo "== inline DEFAULT ROLE in ALTER USER =="
  grep -nE '^ALTER USER .* DEFAULT ROLE ' "{{input_sql}}" || echo "  (none)"
  echo ""
  echo "== risky privileges =="
  grep -nE 'SUPER|SYSTEM_VARIABLES_ADMIN|SESSION_VARIABLES_ADMIN|BINLOG_ADMIN|ROLE_ADMIN|SET_USER_ID|FILE|SHUTDOWN' "{{input_sql}}" || echo "  (none)"

# hint: source_host: e.g. <host from ~/.config/mysql/hosts>
# hint: source_user: e.g. <db user>
# hint: raw_sql: intermediate raw grants file
# hint: sanitized_sql: final Aurora-compatible output file
# note: pick users to dump via fzf (Tab = multi-select); Enter with none selected = all users

[group('mysql')]
mysql-dump-users source_host source_user raw_sql="users_raw.sql" sanitized_sql="users_sanitized.sql":
  #!/usr/bin/env bash
  set -euo pipefail

  pw=$(security find-generic-password -s "mysql-db-connect" -a "{{source_user}}" -w 2>/dev/null || true)
  [ -z "$pw" ] && { echo "Keychain에 비밀번호 없음 (account={{source_user}})" >&2; exit 1; }

  echo "[1/3] Selecting users from {{source_host}}..."
  mapfile -t picked < <(MYSQL_PWD="$pw" mysql -h "{{source_host}}" -u "{{source_user}}" -Nse \
    "SELECT CONCAT(user,'@',host) FROM mysql.user \
     WHERE user NOT IN ('rdsadmin','mysql.session','mysql.sys','mysql.infoschema') \
     ORDER BY user, host" \
    | fzf --multi --prompt="dump users (Tab=multi, empty=all)> " --height=60% --scheme=default)

  only_args=()
  if [ "${#picked[@]}" -gt 0 ]; then
    only=$(IFS=,; printf '%s' "${picked[*]}")
    only_args=(--only "$only")
    echo "  selected: ${#picked[@]} user(s)"
  else
    echo "  no selection -> dumping ALL users"
  fi

  echo "  Dumping grants..."
  # --password=... would put the password in argv, where any user on the box can
  # read it out of `ps`. pt-show-grants supports --defaults-file (-F), so use the
  # same temp 0600 file that pt-osc below uses.
  cnf=$(mktemp)
  chmod 600 "$cnf"
  trap 'rm -f "$cnf"' EXIT
  printf '[client]\npassword=%s\n' "$pw" > "$cnf"
  pt-show-grants --defaults-file="$cnf" --host="{{source_host}}" --user="{{source_user}}" ${only_args[@]+"${only_args[@]}"} > "{{raw_sql}}"
  echo "  Written: {{raw_sql}}"

  echo "[2/3] Sanitizing for Aurora/RDS..."
  python3 "{{SANITIZE_SCRIPT}}" "{{raw_sql}}" "{{sanitized_sql}}"
  echo "  Written: {{sanitized_sql}}"

  echo "[3/3] Checking for leftover issues..."
  issues=0
  if grep -qE 'rdsadmin|mysql\.session|mysql\.sys|mysql\.infoschema|rds_superuser_role' "{{sanitized_sql}}"; then
    echo "  [WARN] internal/system accounts found:"
    grep -nE 'rdsadmin|mysql\.session|mysql\.sys|mysql\.infoschema|rds_superuser_role' "{{sanitized_sql}}"
    issues=$((issues + 1))
  fi
  if grep -qE '^ALTER USER .* DEFAULT ROLE ' "{{sanitized_sql}}"; then
    echo "  [WARN] inline DEFAULT ROLE in ALTER USER:"
    grep -nE '^ALTER USER .* DEFAULT ROLE ' "{{sanitized_sql}}"
    issues=$((issues + 1))
  fi
  if grep -qE 'SUPER|SYSTEM_VARIABLES_ADMIN|SESSION_VARIABLES_ADMIN|BINLOG_ADMIN|ROLE_ADMIN|SET_USER_ID|FILE|SHUTDOWN' "{{sanitized_sql}}"; then
    echo "  [WARN] risky privileges found:"
    grep -nE 'SUPER|SYSTEM_VARIABLES_ADMIN|SESSION_VARIABLES_ADMIN|BINLOG_ADMIN|ROLE_ADMIN|SET_USER_ID|FILE|SHUTDOWN' "{{sanitized_sql}}"
    issues=$((issues + 1))
  fi
  if [ "$issues" -eq 0 ]; then
    echo "  OK — no issues found"
  fi

  raw_abs=$(cd "$(dirname "{{raw_sql}}")" && printf '%s/%s' "$(pwd)" "$(basename "{{raw_sql}}")")
  san_abs=$(cd "$(dirname "{{sanitized_sql}}")" && printf '%s/%s' "$(pwd)" "$(basename "{{sanitized_sql}}")")
  raw_size=$(du -h "{{raw_sql}}" | cut -f1)
  san_size=$(du -h "{{sanitized_sql}}" | cut -f1)
  raw_users=$(grep -cE '^CREATE USER' "{{raw_sql}}" || true)
  san_users=$(grep -cE '^CREATE USER' "{{sanitized_sql}}" || true)
  san_roles=$(grep -cE '^CREATE ROLE' "{{sanitized_sql}}" || true)
  san_defrole=$(grep -cE '^SET DEFAULT ROLE' "{{sanitized_sql}}" || true)
  dropped=$(( raw_users - san_users ))

  echo ""
  echo "==================== DUMP SUMMARY ===================="
  echo "  source     : {{source_user}}@{{source_host}}"
  echo "  raw grants : $raw_abs  ($raw_size, $raw_users users)"
  echo "  sanitized  : $san_abs  ($san_size)"
  echo "     users    : $san_users kept  ($dropped system/reserved dropped)"
  echo "     roles    : $san_roles kept"
  echo "     rewrites : $san_defrole DEFAULT ROLE -> SET DEFAULT ROLE"
  echo "     issues   : $issues"
  echo "====================================================="
  echo ""
  echo "Next: review the sanitized file, then import:"
  echo "  \$EDITOR \"$san_abs\""
  echo "  just mysql-import-users <target_host> <target_user>   # then pick the .sql via fzf"

# hint: target_host: e.g. aurora-skt-otg-uat-cluster.cluster-czdk59pd0a4y.ap-northeast-2.rds.amazonaws.com
# hint: target_user: e.g. <db user>
# note: input SQL is picked via fzf (searches current dir for *.sql); none found -> type path

[group('mysql')]
[confirm("Import users into " + target_user + "@" + target_host + "?")]
mysql-import-users target_host target_user:
  #!/usr/bin/env bash
  set -euo pipefail

  mapfile -t sqls < <(find . -maxdepth 1 -type f -name '*.sql' 2>/dev/null | sed 's:^\./::' | sort)
  if [ "${#sqls[@]}" -gt 0 ]; then
    input_sql=$(printf '%s\n' "${sqls[@]}" | \
      fzf --prompt="import sql> " --height=40% --scheme=default)
  else
    read -rp "sql file (경로 직접 입력): " input_sql
  fi
  [ -z "$input_sql" ] && exit 0
  [ -f "$input_sql" ] || { echo "파일 없음: $input_sql" >&2; exit 1; }

  # Keychain first, passed via MYSQL_PWD so it never lands in argv; prompt only
  # when there is no entry for this account. The dump recipes already do this --
  # this one used to prompt every time.
  pw=$(security find-generic-password -s "mysql-db-connect" -a "{{target_user}}" -w 2>/dev/null || true)
  run_mysql() {
    if [ -n "$pw" ]; then MYSQL_PWD="$pw" mysql "$@"; else mysql --password "$@"; fi
  }

  if run_mysql --host="{{target_host}}" --user="{{target_user}}" < "$input_sql"; then
    echo "Imported: $input_sql -> {{target_user}}@{{target_host}}"
  else
    rc=$?
    echo "Import FAILED (exit $rc): $input_sql" >&2
    exit "$rc"
  fi

# hint: host: e.g. <host from ~/.config/mysql/hosts>
# hint: user: e.g. <db user>

[group('mysql')]
mysql-binlog-status host user:
  #!/usr/bin/env bash
  set -euo pipefail
  # This used to pass --password twice, so it prompted twice for the same
  # credential. The two calls are kept -- they are what keeps the two sections
  # separately labelled -- but the password now comes from the Keychain.
  pw=$(security find-generic-password -s "mysql-db-connect" -a "{{user}}" -w 2>/dev/null || true)
  run_mysql() {
    if [ -n "$pw" ]; then MYSQL_PWD="$pw" mysql "$@"; else mysql --password "$@"; fi
  }
  echo "== Current binlog position =="
  # -E instead of a trailing \G: this client (26.7.0) rejects \G inside -e with
  # "Unknown command '\G'", so the recipe failed on its first line. -E gives the
  # same vertical layout. Pre-existing bug, unrelated to the Keychain change.
  run_mysql --host="{{host}}" --user="{{user}}" -E -e "SHOW MASTER STATUS"
  echo ""
  echo "== Available binary logs =="
  run_mysql --host="{{host}}" --user="{{user}}" -e "SHOW BINARY LOGS"

# hint: host: e.g. <host from ~/.config/mysql/hosts>
# hint: user: e.g. <db user>
# hint: binlog: binlog filename (from mysql-binlog-status)
# hint: start_datetime: e.g. "2026-03-17 09:00:00"
# hint: stop_datetime: e.g. "2026-03-17 10:00:00"
# hint: output: output SQL file (default: binlog_recover_<timestamp>.sql)

[group('mysql')]
mysql-binlog-extract host user binlog start_datetime stop_datetime output="":
  #!/usr/bin/env bash
  set -euo pipefail
  timestamp=$(date +%Y%m%d_%H%M%S)
  out="{{output}}"
  [ -z "$out" ] && out="binlog_recover_${timestamp}.sql"
  # Keychain via a temp 0600 --defaults-file (mysqlbinlog supports -F) instead of
  # prompting. --defaults-file must come before the other options.
  pw=$(security find-generic-password -s "mysql-db-connect" -a "{{user}}" -w 2>/dev/null || true)
  auth=(--password)
  if [ -n "$pw" ]; then
    cnf=$(mktemp)
    chmod 600 "$cnf"
    trap 'rm -f "$cnf"' EXIT
    printf '[client]\npassword=%s\n' "$pw" > "$cnf"
    auth=(--defaults-file="$cnf")
  fi
  mysqlbinlog \
    "${auth[@]}" \
    --read-from-remote-server \
    --host="{{host}}" \
    --user="{{user}}" \
    --start-datetime="{{start_datetime}}" \
    --stop-datetime="{{stop_datetime}}" \
    "{{binlog}}" > "$out"
  echo "Written: $out"
  echo "Review $out, then run: mysql --host=<target> --user=<user> --password < $out"

# hint: host: e.g. <host from ~/.config/mysql/hosts>
# hint: user: e.g. <db user>
# hint: binlog: binlog filename (from mysql-binlog-status)
# hint: start_position: start position (from SHOW MASTER STATUS)
# hint: stop_position: stop position
# hint: output: output SQL file (default: binlog_recover_<timestamp>.sql)

[group('mysql')]
mysql-binlog-extract-pos host user binlog start_position stop_position output="":
