# hint: host: e.g. aurora-dev.otg.apac.npr.aws.asurion.net
# hint: user: e.g. giho.seong
# hint: database: target schema
# hint: tables: comma-separated table names (e.g. TABLE1,TABLE2)
# hint: threads: parallel threads (default: 4)
# hint: outdir: output directory (default: dump_<database>_tables_<timestamp>)

mysqlsh-dump-tables host user database tables threads="4" outdir="":
  #!/usr/bin/env bash
  set -euo pipefail
  timestamp=$(date +%Y%m%d_%H%M%S)
  out="{{outdir}}"
  [ -z "$out" ] && out="dump_{{database}}_tables_${timestamp}"
  IFS=',' read -r -a raw_tbl_array <<< "{{tables}}"
  [ "${#raw_tbl_array[@]}" -gt 0 ] || { echo "No tables provided" >&2; exit 1; }
  tbl_array=()
  for table in "${raw_tbl_array[@]}"; do
    table=$(printf '%s' "$table" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    [ -z "$table" ] && { echo "Empty table name in tables list" >&2; exit 1; }
    tbl_array+=("$table")
  done
  mysqlsh --host="{{host}}" --user="{{user}}" \
    -- util dump-tables "{{database}}" "${tbl_array[@]}" \
    --outputUrl="$out" \
    --threads={{threads}} --consistent=false --compression=zstd
  echo "Written: $out/"

# hint: host: e.g. aurora-dev.otg.apac.npr.aws.asurion.net
# hint: user: e.g. giho.seong
# hint: database: target schema (empty = dump-instance, auto-excludes mysql/sys/information_schema/performance_schema)
# hint: threads: parallel threads (default: 4)
# hint: outdir: output directory (default: dump_<database or all>_<timestamp>)

mysqlsh-dump-data host user database="" threads="4" outdir="":
  #!/usr/bin/env bash
  set -euo pipefail
  timestamp=$(date +%Y%m%d_%H%M%S)
  out="{{outdir}}"
  if [ -z "{{database}}" ]; then
    [ -z "$out" ] && out="dump_all_${timestamp}"
    mysqlsh --host="{{host}}" --user="{{user}}" \
      -- util dump-instance "$out" \
      --threads={{threads}} --consistent=false --compression=zstd
  else
    [ -z "$out" ] && out="dump_{{database}}_${timestamp}"
    mysqlsh --host="{{host}}" --user="{{user}}" \
      -- util dump-schemas "{{database}}" \
      --outputUrl="$out" \
      --threads={{threads}} --consistent=false --compression=zstd
  fi
  echo "Written: $out/"

# hint: host: e.g. aurora-dev.otg.apac.npr.aws.asurion.net
# hint: user: e.g. giho.seong
# hint: database: target schema (empty = dump-instance, auto-excludes mysql/sys/information_schema/performance_schema)
# hint: threads: parallel threads (default: 4)
# hint: outdir: output directory (default: dump_<database or all>_nodata_<timestamp>)

mysqlsh-dump-no-data host user database="" threads="4" outdir="":
  #!/usr/bin/env bash
  set -euo pipefail
  timestamp=$(date +%Y%m%d_%H%M%S)
  out="{{outdir}}"
  if [ -z "{{database}}" ]; then
    [ -z "$out" ] && out="dump_all_nodata_${timestamp}"
    mysqlsh --host="{{host}}" --user="{{user}}" \
      -- util dump-instance "$out" \
      --threads={{threads}} --consistent=false --compression=zstd --ddlOnly=true
  else
    [ -z "$out" ] && out="dump_{{database}}_nodata_${timestamp}"
    mysqlsh --host="{{host}}" --user="{{user}}" \
      -- util dump-schemas "{{database}}" \
      --outputUrl="$out" \
      --threads={{threads}} --consistent=false --compression=zstd --ddlOnly=true
  fi
  echo "Written: $out/"

# hint: host: e.g. aurora-skt-otg-uat-cluster.cluster-czdk59pd0a4y.ap-northeast-2.rds.amazonaws.com
# hint: user: e.g. giho.seong
# hint: indir: dump directory from mysqlsh-dump-data
# hint: threads: parallel threads (default: 4)
# hint: target_schema: optional schema to load into; leave empty to use dump schema

mysqlsh-load host user indir threads="4" target_schema="":
  #!/usr/bin/env bash
  set -euo pipefail

  target_schema="{{target_schema}}"
  progress_file="{{indir}}/.load_progress"
  load_args=(
    -- util load-dump "{{indir}}"
    --threads={{threads}}
  )

  if [ -n "$target_schema" ]; then
    safe_schema=$(printf '%s' "$target_schema" | tr -c 'A-Za-z0-9_.-' '_')
    progress_file="{{indir}}/.load_progress_${safe_schema}"
    load_args+=(--schema="$target_schema")
  fi

  load_args+=(--progressFile="$progress_file")

  mysqlsh --host="{{host}}" --user="{{user}}" "${load_args[@]}"
  if [ -n "$target_schema" ]; then
    echo "Loaded: {{indir}} into schema $target_schema"
  else
    echo "Loaded: {{indir}}"
  fi

# hint: host: e.g. aurora-skt-otg-uat-cluster.cluster-czdk59pd0a4y.ap-northeast-2.rds.amazonaws.com
# hint: user: e.g. giho.seong
# hint: indir: dump directory from mysqlsh-dump-tables
# hint: target_schema: final schema to move into (e.g. datawarehouse)
# hint: source_table: dumped table name before rename (e.g. fact_enrollment)
# hint: target_table: final table name after rename (e.g. fact_enrollment_new)
# hint: threads: parallel threads (default: 4)

mysqlsh-load-rename-table host user indir target_schema source_table target_table threads="4":
  #!/usr/bin/env bash
  set -euo pipefail

  escape_ident() {
    printf '%s' "$1" | sed 's/`/``/g'
  }

  timestamp=$(date +%Y%m%d_%H%M%S)
  temp_schema="_tmp_restore_{{source_table}}_${timestamp}"
  tmp_schema_esc=$(escape_ident "$temp_schema")
  source_table_esc=$(escape_ident "{{source_table}}")
  target_schema_esc=$(escape_ident "{{target_schema}}")
  target_table_esc=$(escape_ident "{{target_table}}")
  progress_file="{{indir}}/.load_progress_${temp_schema}_{{source_table}}"

  cleanup_temp_schema() {
    local cleanup_sql
    printf -v cleanup_sql 'DROP DATABASE IF EXISTS `%s`;' "$tmp_schema_esc"
    mysqlsh --host="{{host}}" --user="{{user}}" --sql -e "$cleanup_sql"
  }

  on_error() {
    echo "Restore failed. Temporary schema kept: $temp_schema" >&2
  }
  trap on_error ERR

  printf -v create_sql 'CREATE DATABASE IF NOT EXISTS `%s`; CREATE DATABASE IF NOT EXISTS `%s`;'     "$tmp_schema_esc" "$target_schema_esc"
  mysqlsh --host="{{host}}" --user="{{user}}" --sql -e "$create_sql"

  printf -v load_js 'util.loadDump("%s", {schema: "%s", threads: %s, progressFile: "%s"})'     "{{indir}}" "$temp_schema" "{{threads}}" "$progress_file"
  mysqlsh --host="{{host}}" --user="{{user}}" --js -e "$load_js"

  printf -v rename_sql 'RENAME TABLE `%s`.`%s` TO `%s`.`%s`;'     "$tmp_schema_esc" "$source_table_esc" "$target_schema_esc" "$target_table_esc"
  mysqlsh --host="{{host}}" --user="{{user}}" --sql -e "$rename_sql"

  cleanup_temp_schema
  trap - ERR
  echo "Loaded {{indir}} into {{target_schema}}.{{target_table}} via temp schema $temp_schema"

# DynamoDB

# DynamoDB 테이블 목록 조회
ddb-list:
  aws dynamodb list-tables --output table

# fzf로 테이블 선택 후 상세 정보 조회
ddb-describe:
  #!/usr/bin/env bash
  set -euo pipefail
  selected=$(aws dynamodb list-tables --output json | \
    python3 -c "import sys,json; [print(t) for t in json.load(sys.stdin)['TableNames']]" | \
    fzf --prompt="table> " --height=40% --scheme=default)
  [ -z "$selected" ] && exit 0
  aws dynamodb describe-table --table-name "$selected" | python3 -m json.tool

# fzf로 테이블 선택 후 정확한 row 수 조회 (scan count, 대용량 주의)
ddb-count:
  #!/usr/bin/env bash
  set -euo pipefail
  selected=$(aws dynamodb list-tables --output json | \
    python3 -c "import sys,json; [print(t) for t in json.load(sys.stdin)['TableNames']]" | \
    fzf --prompt="table> " --height=40% --scheme=default)
  [ -z "$selected" ] && exit 0
  echo ">> counting $selected (scan, may take a while)..."
  aws dynamodb scan --table-name "$selected" --select COUNT \
    --query "Count" --output text | xargs -I{} echo "Count: {}"

# hint: source_table: 복사할 원본 테이블
# hint: new_table: 새로 만들 테이블 이름
ddb-copy source_table new_table:
  python3 "{{DDB_SCRIPT_DIR}}/create/copy_table.py" "{{source_table}}" "{{new_table}}" --execute

# hint: source_table: 복사할 원본 테이블
# hint: new_table: 새로 만들 테이블 이름
# hint: limit: 복사할 최대 row 수 (default: 전체)
ddb-copy-data source_table new_table limit="":
  #!/usr/bin/env bash
  set -euo pipefail
  if [ -n "{{limit}}" ]; then
    python3 "{{DDB_SCRIPT_DIR}}/create/copy_table.py" "{{source_table}}" "{{new_table}}" --data --limit "{{limit}}"
  else
    python3 "{{DDB_SCRIPT_DIR}}/create/copy_table.py" "{{source_table}}" "{{new_table}}" --data
  fi

# sysbench

# hint: threads: concurrent threads (default: 4)
# hint: time: test duration in seconds (default: 60)
# hint: tables: number of test tables (default: 4)
# hint: table_size: rows per table (default: 100000)
# hint: db: target database/schema (default: sbtest)
sysbench-prepare threads="4" tables="4" table_size="100000" db="sbtest":
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  selected=$(grep -v '^#' "$HOSTS_FILE" | grep -v '^$' | \
    fzf --prompt="sysbench host> " --height=40% --scheme=default)
  [ -z "$selected" ] && exit 0
  host=$(echo "$selected" | cut -d: -f2)
  port=$(echo "$selected" | cut -d: -f3)
  user=$(echo "$selected" | cut -d: -f4)
  echo ">> prepare on $host (db={{db}}, tables={{tables}}, rows={{table_size}})"
  sysbench oltp_read_write \
    --db-driver=mysql \
    --mysql-host="$host" \
    --mysql-port="$port" \
    --mysql-user="$user" \
    --mysql-password \
    --mysql-db="{{db}}" \
    --tables={{tables}} \
    --table-size={{table_size}} \
    --threads={{threads}} \
    prepare

# hint: threads: concurrent threads (default: 4)
# hint: time: test duration in seconds (default: 60)
# hint: tables: number of test tables (default: 4)
# hint: table_size: rows per table (default: 100000)
# hint: db: target database/schema (default: sbtest)
sysbench-run threads="4" time="60" tables="4" table_size="100000" db="sbtest":
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  selected=$(grep -v '^#' "$HOSTS_FILE" | grep -v '^$' | \
    fzf --prompt="sysbench host> " --height=40% --scheme=default)
  [ -z "$selected" ] && exit 0
  host=$(echo "$selected" | cut -d: -f2)
  port=$(echo "$selected" | cut -d: -f3)
  user=$(echo "$selected" | cut -d: -f4)
  echo ">> run on $host (threads={{threads}}, time={{time}}s, db={{db}})"
  sysbench oltp_read_write \
    --db-driver=mysql \
    --mysql-host="$host" \
    --mysql-port="$port" \
    --mysql-user="$user" \
    --mysql-password \
    --mysql-db="{{db}}" \
    --tables={{tables}} \
    --table-size={{table_size}} \
    --threads={{threads}} \
    --time={{time}} \
    --report-interval=10 \
    run

