# AWS RDS

# aws-rds-list:
#   python3 "$HOME/.config/mysql/rds_table.py" clusters

# RDS 인스턴스 / Aurora 클러스터 목록.
# 이전 버전은 rds_table.py 에 아무 입력도 주지 않아 stdin 을 기다리다 멈추거나
# JSONDecodeError 로 죽었다. 이제 조회까지 recipe 안에서 한다.
# hint: what: instances (default) | clusters
[group('aws')]
aws-rds-list what="instances":
  #!/usr/bin/env bash
  set -euo pipefail
  color=1; { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0

  if [ "{{what}}" = "clusters" ]; then
    {
      # No endpoint column: its first label is just the cluster id again. Backup
      # retention and the exported log types are what actually differ per cluster.
      printf 'cluster\tstatus\tengine\tmembers\tbackup_days\tcw_logs\n'
      aws rds describe-db-clusters --output text --query \
        'sort_by(DBClusters, &DBClusterIdentifier)[*].[DBClusterIdentifier,Status,EngineVersion,length(DBClusterMembers),BackupRetentionPeriod,join(`,`, EnabledCloudwatchLogsExports || [`-`])]'
    } | COLOR="$color" python3 "{{TABLE_PY}}"
  else
    {
      printf 'cluster\tinstance\tclass\tstatus\tengine\taz\n'
      aws rds describe-db-instances --output text --query \
        'sort_by(DBInstances, &DBInstanceIdentifier)[*].[DBClusterIdentifier,DBInstanceIdentifier,DBInstanceClass,DBInstanceStatus,EngineVersion,AvailabilityZone]'
    } | COLOR="$color" python3 "{{TABLE_PY}}"
  fi

# hint: pg: cluster parameter group name (e.g. webfulfillment-mdb-prod-80-cg)
# hint: region: AWS region (default: ap-northeast-2)
#
# Zero-ETL (Aurora MySQL -> Redshift) 필수 cluster 파라미터 세팅.
# aurora_enhanced_binlog / binlog_backup / binlog_replication_globaldb 는 static ->
# 적용하려면 writer 인스턴스 재부팅 필요. AWS_PROFILE 을 미리 export 해두고 실행.

[group('aws')]
[confirm("Modify RDS parameter group " + pg + " in " + region + "?")]
rds-zeroetl-params pg region="ap-northeast-2":
  #!/usr/bin/env bash
  set -euo pipefail
  echo ">> Applying zero-ETL cluster params to: {{pg}} ({{region}})"
  aws rds modify-db-cluster-parameter-group \
    --region "{{region}}" \
    --db-cluster-parameter-group-name "{{pg}}" \
    --parameters \
      "ParameterName=aurora_enhanced_binlog,ParameterValue=1,ApplyMethod=pending-reboot" \
      "ParameterName=binlog_backup,ParameterValue=0,ApplyMethod=pending-reboot" \
      "ParameterName=binlog_replication_globaldb,ParameterValue=0,ApplyMethod=pending-reboot" \
      "ParameterName=binlog_format,ParameterValue=ROW,ApplyMethod=pending-reboot" \
      "ParameterName=binlog_row_image,ParameterValue=full,ApplyMethod=immediate" \
      "ParameterName=binlog_row_metadata,ParameterValue=full,ApplyMethod=immediate"
  echo ""
  echo "Done. static 파라미터 3개는 writer 재부팅 후 적용됩니다:"
  echo "  aws rds reboot-db-instance --region {{region}} --db-instance-identifier <writer-instance>"

# Aurora/RDS user migration

# hint: input_sql: raw SQL from pt-show-grants
# hint: output_sql: sanitized output file for Aurora/RDS

[group('mysql')]
mysql-sanitize-users input_sql="users_raw.sql" output_sql="users_sanitized.sql":
  #!/usr/bin/env bash
  set -euo pipefail
  python3 "{{SANITIZE_SCRIPT}}" "{{input_sql}}" "{{output_sql}}"
  echo "Written: {{output_sql}}"

# hint: input_sql: sanitized SQL to validate before import

[group('mysql')]
mysql-check-users input_sql="users_sanitized.sql":
  #!/usr/bin/env bash
  set -euo pipefail
  echo "== internal/system accounts =="
  grep -nE 'rdsadmin|mysql\.session|mysql\.sys|mysql\.infoschema|rds_superuser_role' "{{input_sql}}" || echo "  (none)"
  echo ""
  echo "== inline DEFAULT ROLE in ALTER USER =="
  grep -nE '^ALTER USER .* DEFAULT ROLE ' "{{input_sql}}" || echo "  (none)"
  echo ""
  echo "== risky privileges =="
  grep -nE 'SUPER|SYSTEM_VARIABLES_ADMIN|SESSION_VARIABLES_ADMIN|BINLOG_ADMIN|ROLE_ADMIN|SET_USER_ID|FILE|SHUTDOWN' "{{input_sql}}" || echo "  (none)"

# hint: source_host: e.g. <host from ~/.config/mysql/hosts>
# hint: source_user: e.g. <db user>
# hint: raw_sql: intermediate raw grants file
# hint: sanitized_sql: final Aurora-compatible output file
# note: pick users to dump via fzf (Tab = multi-select); Enter with none selected = all users

[group('mysql')]
mysql-dump-users source_host source_user raw_sql="users_raw.sql" sanitized_sql="users_sanitized.sql":
  #!/usr/bin/env bash
  set -euo pipefail

  pw=$(security find-generic-password -s "mysql-db-connect" -a "{{source_user}}" -w 2>/dev/null || true)
  [ -z "$pw" ] && { echo "Keychain에 비밀번호 없음 (account={{source_user}})" >&2; exit 1; }

  echo "[1/3] Selecting users from {{source_host}}..."
  mapfile -t picked < <(MYSQL_PWD="$pw" mysql -h "{{source_host}}" -u "{{source_user}}" -Nse \
    "SELECT CONCAT(user,'@',host) FROM mysql.user \
     WHERE user NOT IN ('rdsadmin','mysql.session','mysql.sys','mysql.infoschema') \
     ORDER BY user, host" \
    | fzf --multi --prompt="dump users (Tab=multi, empty=all)> " --height=60% --scheme=default)

  only_args=()
  if [ "${#picked[@]}" -gt 0 ]; then
    only=$(IFS=,; printf '%s' "${picked[*]}")
    only_args=(--only "$only")
    echo "  selected: ${#picked[@]} user(s)"
  else
    echo "  no selection -> dumping ALL users"
  fi

  echo "  Dumping grants..."
  # --password=... would put the password in argv, where any user on the box can
  # read it out of `ps`. pt-show-grants supports --defaults-file (-F), so use the
  # same temp 0600 file that pt-osc below uses.
  cnf=$(mktemp)
  chmod 600 "$cnf"
  trap 'rm -f "$cnf"' EXIT
  printf '[client]\npassword=%s\n' "$pw" > "$cnf"
  pt-show-grants --defaults-file="$cnf" --host="{{source_host}}" --user="{{source_user}}" ${only_args[@]+"${only_args[@]}"} > "{{raw_sql}}"
  echo "  Written: {{raw_sql}}"

  echo "[2/3] Sanitizing for Aurora/RDS..."
  python3 "{{SANITIZE_SCRIPT}}" "{{raw_sql}}" "{{sanitized_sql}}"
  echo "  Written: {{sanitized_sql}}"

  echo "[3/3] Checking for leftover issues..."
  issues=0
  if grep -qE 'rdsadmin|mysql\.session|mysql\.sys|mysql\.infoschema|rds_superuser_role' "{{sanitized_sql}}"; then
    echo "  [WARN] internal/system accounts found:"
    grep -nE 'rdsadmin|mysql\.session|mysql\.sys|mysql\.infoschema|rds_superuser_role' "{{sanitized_sql}}"
    issues=$((issues + 1))
  fi
  if grep -qE '^ALTER USER .* DEFAULT ROLE ' "{{sanitized_sql}}"; then
    echo "  [WARN] inline DEFAULT ROLE in ALTER USER:"
    grep -nE '^ALTER USER .* DEFAULT ROLE ' "{{sanitized_sql}}"
    issues=$((issues + 1))
  fi
  if grep -qE 'SUPER|SYSTEM_VARIABLES_ADMIN|SESSION_VARIABLES_ADMIN|BINLOG_ADMIN|ROLE_ADMIN|SET_USER_ID|FILE|SHUTDOWN' "{{sanitized_sql}}"; then
    echo "  [WARN] risky privileges found:"
    grep -nE 'SUPER|SYSTEM_VARIABLES_ADMIN|SESSION_VARIABLES_ADMIN|BINLOG_ADMIN|ROLE_ADMIN|SET_USER_ID|FILE|SHUTDOWN' "{{sanitized_sql}}"
    issues=$((issues + 1))
  fi
  if [ "$issues" -eq 0 ]; then
    echo "  OK — no issues found"
  fi

  raw_abs=$(cd "$(dirname "{{raw_sql}}")" && printf '%s/%s' "$(pwd)" "$(basename "{{raw_sql}}")")
  san_abs=$(cd "$(dirname "{{sanitized_sql}}")" && printf '%s/%s' "$(pwd)" "$(basename "{{sanitized_sql}}")")
  raw_size=$(du -h "{{raw_sql}}" | cut -f1)
  san_size=$(du -h "{{sanitized_sql}}" | cut -f1)
  raw_users=$(grep -cE '^CREATE USER' "{{raw_sql}}" || true)
  san_users=$(grep -cE '^CREATE USER' "{{sanitized_sql}}" || true)
  san_roles=$(grep -cE '^CREATE ROLE' "{{sanitized_sql}}" || true)
  san_defrole=$(grep -cE '^SET DEFAULT ROLE' "{{sanitized_sql}}" || true)
  dropped=$(( raw_users - san_users ))

  echo ""
  echo "==================== DUMP SUMMARY ===================="
  echo "  source     : {{source_user}}@{{source_host}}"
  echo "  raw grants : $raw_abs  ($raw_size, $raw_users users)"
  echo "  sanitized  : $san_abs  ($san_size)"
  echo "     users    : $san_users kept  ($dropped system/reserved dropped)"
  echo "     roles    : $san_roles kept"
  echo "     rewrites : $san_defrole DEFAULT ROLE -> SET DEFAULT ROLE"
  echo "     issues   : $issues"
  echo "====================================================="
  echo ""
  echo "Next: review the sanitized file, then import:"
  echo "  \$EDITOR \"$san_abs\""
  echo "  just mysql-import-users <target_host> <target_user>   # then pick the .sql via fzf"

# hint: target_host: e.g. <host from ~/.config/mysql/hosts>
# hint: target_user: e.g. <db user>
# note: input SQL is picked via fzf (searches current dir for *.sql); none found -> type path

[group('mysql')]
[confirm("Import users into " + target_user + "@" + target_host + "?")]
mysql-import-users target_host target_user:
  #!/usr/bin/env bash
  set -euo pipefail

  mapfile -t sqls < <(find . -maxdepth 1 -type f -name '*.sql' 2>/dev/null | sed 's:^\./::' | sort)
  if [ "${#sqls[@]}" -gt 0 ]; then
    input_sql=$(printf '%s\n' "${sqls[@]}" | \
      fzf --prompt="import sql> " --height=40% --scheme=default || true)
  else
    read -rp "sql file (경로 직접 입력): " input_sql
  fi
  [ -z "$input_sql" ] && exit 0
  [ -f "$input_sql" ] || { echo "파일 없음: $input_sql" >&2; exit 1; }

  # Keychain first, passed via MYSQL_PWD so it never lands in argv; prompt only
  # when there is no entry for this account. The dump recipes already do this --
  # this one used to prompt every time.
  pw=$(security find-generic-password -s "mysql-db-connect" -a "{{target_user}}" -w 2>/dev/null || true)
  run_mysql() {
    if [ -n "$pw" ]; then MYSQL_PWD="$pw" mysql "$@"; else mysql --password "$@"; fi
  }

  if run_mysql --host="{{target_host}}" --user="{{target_user}}" < "$input_sql"; then
    echo "Imported: $input_sql -> {{target_user}}@{{target_host}}"
  else
    rc=$?
    echo "Import FAILED (exit $rc): $input_sql" >&2
    exit "$rc"
  fi

# DB 계정 만들기. 여러 호스트(환경)에 한 번에. 플래그 없이 실행하면 SQL 만 출력한다(dry-run).
#   서비스 계정  이름에 {env} 를 쓰면 호스트마다 d/q/u/p 로 바뀐다 (svc.chb-{env}-asot).
#                권한은 세트에서 골라 스키마마다 더한다.
#   사람 계정    role 을 골라 GRANT + SET DEFAULT ROLE 까지 한다 (MySQL 8).
# 비밀번호는 호스트마다 새로 만들어 SQL 을 표준입력으로 넘긴다 -- 명령줄에도 셸
# 히스토리에도 남지 않는다. 손으로 칠 때는 identified by '...' 가 atuin 에 평문으로
# 남았다. 이미 있는 계정은 건너뛴다 (비밀번호를 바꾸지 않는다).
# hint: execute: true 면 실제로 만든다
[group('mysql')]
mysql-create-user execute="false":
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  {{MYSQL_CONNECT}}

  # 1) 호스트 (Tab 으로 여러 개)
  mapfile -t raws < <(grep -vE "^#|^$" "$HOSTS_FILE" | grep -vE ":(pg|postgres|postgresql)(:|$)" \
    | awk -F: '{printf "%s\t%-26s %s:%s\n", $0, $1, $2, $3}' \
    | fzf --multi --prompt="hosts (Tab=multi)> " --height=50% --scheme=default \
          --delimiter=$'\t' --with-nth=2 | cut -f1 || true)
  [ "${#raws[@]}" -gt 0 ] || exit 0

  # 호스트 라벨의 끝 단어(DEV/SQA/UAT/PROD/TEST) -> 계정 이름의 {env}
  env_letter() {
    case "${1##* }" in DEV) echo d ;; SQA) echo q ;; UAT) echo u ;; PROD) echo p ;; TEST) echo t ;; *) return 1 ;; esac
  }

  # 2) 종류와 이름
  kind=$(printf '%s\n' "[서비스 계정]" "[사람 계정 (role)]" | \
    fzf --prompt="종류> " --height=20% --scheme=default || true)
  [ -n "$kind" ] || exit 0
  if [ "$kind" = "[서비스 계정]" ]; then
    read -rp "계정 이름 (호스트마다 바뀌는 부분은 {env} -> d/q/u/p, 예: svc.chb-{env}-asot): " tmpl
  else
    read -rp "계정 이름 (예: gildong.hong): " tmpl
  fi
  [ -n "$tmpl" ] || exit 0
  # 계정 이름은 SQL 에 그대로 들어가니 모양을 막는다
  [[ "${tmpl//\{env\}/x}" =~ ^[A-Za-z0-9._-]{1,32}$ ]] || { echo "계정 이름은 영문·숫자·. _ - 로 32자까지: $tmpl" >&2; exit 1; }
  if [ "${#raws[@]}" -gt 1 ] && [[ "$tmpl" != *"{env}"* ]] && [ "$kind" = "[서비스 계정]" ]; then
    echo ">> {env} 가 없어서 모든 호스트에 같은 이름으로 만듭니다: $tmpl" >&2
  fi

  # 3) 권한 -- 목록은 첫 호스트에서 읽는다
  setup_conn "" "${raws[0]}"
  grants=()
  if [ "$kind" = "[사람 계정 (role)]" ]; then
    # role = 잠겨 있고 비밀번호가 없는 계정. rds_superuser_role 은 관리자 권한이라 뺀다.
    role=$(run_sql -N -e "SELECT user FROM mysql.user WHERE account_locked='Y' AND authentication_string='' AND user <> 'rds_superuser_role' ORDER BY user NOT LIKE 'role\_%', user" | \
      fzf --prompt="role> " --height=40% --scheme=default || true)
    [ -n "$role" ] || exit 0
  else
    rw="SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, CREATE TEMPORARY TABLES, EXECUTE"
    while :; do
      preset=$(printf '%s\n' "[앱 읽기쓰기] $rw" "[읽기 전용] SELECT" "[DML 모든 DB] SELECT, INSERT, UPDATE, DELETE, EXECUTE ON *.*" \
        ${grants[@]+"[끝]"} | fzf --prompt="권한 $(( ${#grants[@]} + 1 ))> " --height=30% --scheme=default || true)
      [ -n "$preset" ] || exit 0
      [ "$preset" = "[끝]" ] && break
      privs="${preset#*] }"
      if [[ "$privs" == *" ON *.*" ]]; then
        grants+=("$privs")
      else
        db=$(run_sql -N -e "SELECT schema_name FROM information_schema.schemata WHERE schema_name NOT IN ('mysql','sys','information_schema','performance_schema') ORDER BY 1" | \
          fzf --prompt="스키마 ($privs)> " --height=40% --scheme=default || true)
        [ -n "$db" ] || continue
        grants+=("$privs ON \`$db\`.*")
      fi
    done
  fi

  # 4) 호스트마다 SQL
  gen_pw() {  # 20자: 대문자·소문자·숫자·기호 각 하나 이상. 따옴표·백슬래시·$ 는 뺀다.
    python3 -c 'import secrets,string as s
  pool=s.ascii_letters+s.digits+"!#%*+-=?@^_"
  while True:
      p="".join(secrets.choice(pool) for _ in range(20))
      if any(c.islower() for c in p) and any(c.isupper() for c in p) and any(c.isdigit() for c in p) and any(c in "!#%*+-=?@^_" for c in p): print(p); break'
  }
  todo=(); names=(); pws=(); sqls=(); skipped=()
  for raw in "${raws[@]}"; do
    setup_conn "" "$raw"
    name="$tmpl"
    if [[ "$tmpl" == *"{env}"* ]]; then
      e=$(env_letter "$label") || { echo "호스트 라벨에서 환경(DEV/SQA/UAT/PROD/TEST)을 못 찾았습니다: $label" >&2; exit 1; }
      name="${tmpl//\{env\}/$e}"
    fi
    if [ "$(run_sql -N -e "SELECT COUNT(*) FROM mysql.user WHERE user='$name' AND host='%'")" != "0" ]; then
      skipped+=("$label: $name (이미 있음)"); continue
    fi
    p=$(gen_pw)
    sql="CREATE USER '$name'@'%' IDENTIFIED BY '$p';"
    if [ -n "${role:-}" ]; then
      sql+=$'\n'"GRANT \`$role\` TO '$name'@'%';"$'\n'"SET DEFAULT ROLE \`$role\` TO '$name'@'%';"
    else
      for g in "${grants[@]}"; do sql+=$'\n'"GRANT $g TO '$name'@'%';"; done
    fi
    todo+=("$raw"); names+=("$name"); pws+=("$p"); sqls+=("$sql")
    echo "" >&2; echo "-- $label  ($host)" >&2
    printf '%s\n' "${sql//"$p"/<생성됨>}" >&2   # "$p" 로 감싸야 글롭이 아니라 문자 그대로 비교한다
  done
  for sk in ${skipped[@]+"${skipped[@]}"}; do echo ">> 건너뜀: $sk" >&2; done
  [ "${#todo[@]}" -gt 0 ] || { echo ">> 만들 계정이 없습니다." >&2; exit 0; }

  if [ "{{execute}}" != "true" ]; then
    echo "" >&2; echo ">> dry-run only. Pass execute=true to create ${#todo[@]} account(s)." >&2; exit 0
  fi
  printf '\nCreate %d account(s)? [y/N] ' "${#todo[@]}"
  read -r reply || reply=""
  case "$reply" in y|Y|yes|YES) ;; *) echo "Aborted."; exit 1 ;; esac

  # 5) 실행. SQL 은 표준입력으로 -- 비밀번호가 argv 에 안 나온다.
  done_rows=(); failed=0
  for i in "${!todo[@]}"; do
    setup_conn "" "${todo[$i]}"
    if printf '%s\n' "${sqls[$i]}" | run_sql; then
      done_rows+=("$label"$'\t'"${names[$i]}"$'\t'"${pws[$i]}")
    else
      echo "❌ 실패: $label ${names[$i]}" >&2; failed=1
    fi
  done
  if [ "${#done_rows[@]}" -gt 0 ]; then
    echo ""; echo ">> 만든 계정 (비밀번호는 여기서 한 번만 보입니다 -- 바로 옮겨 두세요)"
    printf '%s\n' "${done_rows[@]}" | awk -F'\t' '{printf "   %-16s %-24s %s\n", $1, $2, $3}'
  fi
  exit "$failed"

# hint: host: e.g. <host from ~/.config/mysql/hosts>
# hint: user: e.g. <db user>

[group('mysql')]
mysql-binlog-status host user:
  #!/usr/bin/env bash
  set -euo pipefail
  # This used to pass --password twice, so it prompted twice for the same
  # credential. The two calls are kept -- they are what keeps the two sections
  # separately labelled -- but the password now comes from the Keychain.
  pw=$(security find-generic-password -s "mysql-db-connect" -a "{{user}}" -w 2>/dev/null || true)
  run_mysql() {
    if [ -n "$pw" ]; then MYSQL_PWD="$pw" mysql "$@"; else mysql --password "$@"; fi
  }
  echo "== Current binlog position =="
  # -E instead of a trailing \G: this client (26.7.0) rejects \G inside -e with
  # "Unknown command '\G'", so the recipe failed on its first line. -E gives the
  # same vertical layout. Pre-existing bug, unrelated to the Keychain change.
  run_mysql --host="{{host}}" --user="{{user}}" -E -e "SHOW MASTER STATUS"
  echo ""
  echo "== Available binary logs =="
  run_mysql --host="{{host}}" --user="{{user}}" -e "SHOW BINARY LOGS"

# hint: host: e.g. <host from ~/.config/mysql/hosts>
# hint: user: e.g. <db user>
# hint: binlog: binlog filename (from mysql-binlog-status)
# hint: start_datetime: e.g. "2026-03-17 09:00:00"
# hint: stop_datetime: e.g. "2026-03-17 10:00:00"
# hint: output: output SQL file (default: binlog_recover_<timestamp>.sql)

[group('mysql')]
mysql-binlog-extract host user binlog start_datetime stop_datetime output="":
  #!/usr/bin/env bash
  set -euo pipefail
  timestamp=$(date +%Y%m%d_%H%M%S)
  out="{{output}}"
  [ -z "$out" ] && out="binlog_recover_${timestamp}.sql"
  # Keychain via a temp 0600 --defaults-file (mysqlbinlog supports -F) instead of
  # prompting. --defaults-file must come before the other options.
  pw=$(security find-generic-password -s "mysql-db-connect" -a "{{user}}" -w 2>/dev/null || true)
  auth=(--password)
  if [ -n "$pw" ]; then
    cnf=$(mktemp)
    chmod 600 "$cnf"
    trap 'rm -f "$cnf"' EXIT
    printf '[client]\npassword=%s\n' "$pw" > "$cnf"
    auth=(--defaults-file="$cnf")
  fi
  mysqlbinlog \
    "${auth[@]}" \
    --read-from-remote-server \
    --host="{{host}}" \
    --user="{{user}}" \
    --start-datetime="{{start_datetime}}" \
    --stop-datetime="{{stop_datetime}}" \
    "{{binlog}}" > "$out"
  echo "Written: $out"
  echo "Review $out, then run: mysql --host=<target> --user=<user> --password < $out"

# hint: host: e.g. <host from ~/.config/mysql/hosts>
# hint: user: e.g. <db user>
# hint: binlog: binlog filename (from mysql-binlog-status)
# hint: start_position: start position (from SHOW MASTER STATUS)
# hint: stop_position: stop position
# hint: output: output SQL file (default: binlog_recover_<timestamp>.sql)

[group('mysql')]
mysql-binlog-extract-pos host user binlog start_position stop_position output="":
  #!/usr/bin/env bash
  set -euo pipefail
  timestamp=$(date +%Y%m%d_%H%M%S)
  out="{{output}}"
  [ -z "$out" ] && out="binlog_recover_${timestamp}.sql"
  # Keychain via a temp 0600 --defaults-file (mysqlbinlog supports -F) instead of
  # prompting. --defaults-file must come before the other options.
  pw=$(security find-generic-password -s "mysql-db-connect" -a "{{user}}" -w 2>/dev/null || true)
  auth=(--password)
  if [ -n "$pw" ]; then
    cnf=$(mktemp)
    chmod 600 "$cnf"
    trap 'rm -f "$cnf"' EXIT
    printf '[client]\npassword=%s\n' "$pw" > "$cnf"
    auth=(--defaults-file="$cnf")
  fi
  mysqlbinlog \
    "${auth[@]}" \
    --read-from-remote-server \
    --host="{{host}}" \
    --user="{{user}}" \
    --start-position="{{start_position}}" \
    --stop-position="{{stop_position}}" \
    "{{binlog}}" > "$out"
  echo "Written: $out"
  echo "Review $out, then run: mysql --host=<target> --user=<user> --password < $out"

# Online schema change (pt-online-schema-change)

# hint: alter: ALTER clause without "ALTER TABLE <t>", e.g. "ADD COLUMN memo VARCHAR(64) NULL"
# hint: execute: false (default) = --dry-run only; true = real run
# hint: chunk_size: rows per chunk (default: 1000)
# hint: chunk_index: index used to chunk the copy (default: PRIMARY)
# hint: max_load: pause copying above this load (default: Threads_running=100)
# hint: sleep: seconds to sleep after each chunk (default: 0). Use 0.01-0.05 on a server that
#       serves many light queries, where --max-load never trips but the copy still adds latency.
# hint: history: true to write progress to percona.pt_osc_history. Off by default (upstream default
#       too) because pt-osc treats a failed history INSERT as fatal, not best-effort -- measured:
#       with portal_admin it aborts the whole run at "INSERT command denied ... for table
#       pt_osc_history". Needs INSERT on percona.* on the account you run as. Required for resume.
# hint: resume: job_id from a previous failed run (see the history table) to continue from its last chunk
# hint: no_check_alter: true to pass --no-check-alter; needed when the ALTER drops/adds the PRIMARY KEY
# hint: extra: extra pt-osc flags appended verbatim
# note: host, schema and table are picked via fzf. The password comes from Keychain and is
#       written to a temp 0600 defaults-file, so it never lands in argv (visible via ps)
#       or in shell history -- unlike passing --password= on the command line.
# note: --no-drop-old-table/--no-drop-new-table/--no-drop-triggers are added on execute=true ONLY, so
#       _old is kept for manual cleanup and --resume stays possible. pt-osc's own docs: "Drop triggers
#       on the old table" -- so the retained triggers sit on _<tbl>_old, never on the live table.
#       A dry run gets pt-osc's defaults and cleans up after itself.
# note: with history=true, progress lands in percona.pt_osc_history and that is what an external
#       watcher can poll: lower_boundary shows how far the copy got and ts stops advancing if the
#       process died. It is also the only way --resume works.
# note: this recipe previously passed --prompt-before-copy on execute=true. That option is NOT in
#       upstream Percona Toolkit (it came from a 2014 Kakao patch), so pt-osc rejected it at option
#       parsing and the execute path could never run. To change a PRIMARY KEY and PARTITION in one
#       pass -- the case that option existed for, since MySQL cannot do both in one ALTER -- use a
#       --plugin whose after_alter_new_table hook runs the partitioning DDL on the shadow table.
#       That hook fires with --alter already applied and before triggers or any row copy, and unlike
#       the prompt it needs no human at a terminal.

[group('mysql')]
pt-osc alter execute="false" chunk_size="1000" chunk_index="PRIMARY" max_load="Threads_running=100" sleep="0" history="false" resume="" no_check_alter="false" extra="":
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  selected=$(grep -v '^#' "$HOSTS_FILE" | grep -v '^$' | \
    fzf --prompt="pt-osc host> " --height=40% --scheme=default || true)
  [ -z "$selected" ] && exit 0
  host=$(echo "$selected" | cut -d: -f2)
  port=$(echo "$selected" | cut -d: -f3)
  user=$(echo "$selected" | cut -d: -f4)
  pw=$(security find-generic-password -s "mysql-db-connect" -a "$user" -w 2>/dev/null || true)
  [ -z "$pw" ] && { echo "Keychain에 비밀번호 없음 (account=$user)" >&2; exit 1; }

  database=$(MYSQL_PWD="$pw" mysql -h "$host" -P "$port" -u "$user" -Nse \
    "SELECT schema_name FROM information_schema.schemata \
     WHERE schema_name NOT IN ('mysql','sys','information_schema','performance_schema') \
     ORDER BY schema_name" | \
    fzf --prompt="pt-osc schema> " --height=40% --scheme=default || true)
  [ -z "$database" ] && exit 0

  table=$(MYSQL_PWD="$pw" mysql -h "$host" -P "$port" -u "$user" -D "$database" -Nse \
    "SELECT table_name FROM information_schema.tables \
     WHERE table_schema=DATABASE() AND table_type='BASE TABLE' \
     ORDER BY table_name" \
    | fzf --prompt="pt-osc table> " --height=60% --scheme=default || true)
  [ -z "$table" ] && exit 0

  cnf=$(mktemp)
  chmod 600 "$cnf"
  trap 'rm -f "$cnf"' EXIT
  printf '[client]\npassword=%s\n' "$pw" > "$cnf"

  args=(
    --defaults-file="$cnf"
    --host="$host" --port="$port" --user="$user"
    --alter="{{alter}}"
    --chunk-size={{chunk_size}}
    --chunk-index={{chunk_index}}
    --max-load="{{max_load}}"
    --set-vars="innodb_lock_wait_timeout=1,lock_wait_timeout=1"
    --progress=time,30
  )
  [ "{{sleep}}" != "0" ] && args+=(--sleep={{sleep}})
  # --resume can only continue a run that recorded itself, so it implies history.
  { [ "{{history}}" = "true" ] || [ -n "{{resume}}" ]; } && args+=(--history)
  [ -n "{{resume}}" ] && args+=(--resume={{resume}})
  [ "{{no_check_alter}}" = "true" ] && args+=(--no-check-alter)
  if [ "{{execute}}" = "true" ]; then
    # Keep the artifacts of a REAL run for manual inspection/cleanup, and because --resume needs
    # all three. A dry run has nothing worth keeping -- it never touched the original table -- and
    # measured: with these flags a dry run leaves _<tbl>_new behind, so the next dry run of the
    # same table collides with it.
    args+=(--no-drop-old-table --no-drop-new-table --no-drop-triggers --execute)
  else
    args+=(--dry-run)
  fi
  [ -n "{{extra}}" ] && args+=({{extra}})

  echo "target : ${database}.${table} on ${host}:${port}"
  echo "alter  : {{alter}}"
  [ -n "{{resume}}" ] && echo "resume : job_id {{resume}}"
  [ "{{sleep}}" != "0" ] && echo "sleep  : {{sleep}}s per chunk"
  if [ "{{execute}}" = "true" ]; then
    if [ "{{history}}" = "true" ] || [ -n "{{resume}}" ]; then
      echo "mode   : EXECUTE (progress in percona.pt_osc_history; note the job_id to --resume)"
    else
      echo "mode   : EXECUTE (no history -- pass history=true to make --resume possible)"
    fi
  else
    echo "mode   : DRY RUN - pass execute=true to apply"
  fi
  pt-online-schema-change "${args[@]}" D="$database",t="$table"

# AWS DMS

DMS_CLI := "cd " + DMSCTL_ROOT + "/cli && uv run dms"

# DMS 전체 상태 (diff 기반: AWS vs 코드)
[group('dms')]
dms-status:
  {{DMS_CLI}} status

# hint: task: e.g. prod-finance / prod-dax-master (빈값이면 전체)
# hint: source: dax / horizon / otg / soho (옵션)
[group('dms')]
dms-diff task="" source="":
  #!/usr/bin/env bash
  set -euo pipefail
  cd "{{DMSCTL_ROOT}}/cli"
  if [ -n "{{task}}" ] && [ -n "{{source}}" ]; then
    uv run dms diff "{{task}}" --source "{{source}}"
  elif [ -n "{{task}}" ]; then
    uv run dms diff "{{task}}"
  elif [ -n "{{source}}" ]; then
    uv run dms diff --source "{{source}}"
  else
    uv run dms diff
  fi

# hint: task: e.g. prod-finance / all
[group('dms')]
dms-sync task dry_run="true":
  #!/usr/bin/env bash
  set -euo pipefail
  cd "{{DMSCTL_ROOT}}/cli"
  if [ "{{dry_run}}" = "true" ]; then
    uv run dms sync {{task}} --dry-run
  else
    uv run dms sync {{task}} --force
  fi

# hint: target: e.g. prod-finance / horizon / all
[group('dms')]
[confirm("Deploy DMS task " + target + " for real (plan=" + plan + ")?")]
dms-deploy target plan="false":
  #!/usr/bin/env bash
  set -euo pipefail
  cd "{{DMSCTL_ROOT}}/cli"
  if [ "{{plan}}" = "true" ]; then
    uv run dms deploy {{target}} --plan
  else
    uv run dms deploy {{target}}
  fi

# hint: task: e.g. new-task-name
# hint: source: dax / horizon / otg / soho
# hint: tables: e.g. TABLE1,TABLE2 (또는 --from-aws 사용시 빈값)
# hint: from_aws: 기존 AWS task ID에서 import (빈값이면 tables 사용)
