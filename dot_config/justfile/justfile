# Online schema change (pt-online-schema-change)

# hint: alter: ALTER clause without "ALTER TABLE <t>", e.g. "ADD COLUMN memo VARCHAR(64) NULL"
# hint: execute: false (default) = --dry-run only; true = real run
# hint: chunk_size: rows per chunk (default: 1000)
# hint: chunk_index: index used to chunk the copy (default: PRIMARY)
# hint: max_load: pause copying above this load (default: Threads_running=100)
# hint: sleep: seconds to sleep after each chunk (default: 0). Use 0.01-0.05 on a server that
#       serves many light queries, where --max-load never trips but the copy still adds latency.
# hint: history: true to write progress to percona.pt_osc_history. Off by default (upstream default
#       too) because pt-osc treats a failed history INSERT as fatal, not best-effort -- measured:
#       with portal_admin it aborts the whole run at "INSERT command denied ... for table
#       pt_osc_history". Needs INSERT on percona.* on the account you run as. Required for resume.
# hint: resume: job_id from a previous failed run (see the history table) to continue from its last chunk
# hint: no_check_alter: true to pass --no-check-alter; needed when the ALTER drops/adds the PRIMARY KEY
# hint: extra: extra pt-osc flags appended verbatim
# note: host, schema and table are picked via fzf. The password comes from Keychain and is
#       written to a temp 0600 defaults-file, so it never lands in argv (visible via ps)
#       or in shell history -- unlike passing --password= on the command line.
# note: --no-drop-old-table/--no-drop-new-table/--no-drop-triggers are added on execute=true ONLY, so
#       _old is kept for manual cleanup and --resume stays possible. pt-osc's own docs: "Drop triggers
#       on the old table" -- so the retained triggers sit on _<tbl>_old, never on the live table.
#       A dry run gets pt-osc's defaults and cleans up after itself.
# note: with history=true, progress lands in percona.pt_osc_history and that is what an external
#       watcher can poll: lower_boundary shows how far the copy got and ts stops advancing if the
#       process died. It is also the only way --resume works.
# note: this recipe previously passed --prompt-before-copy on execute=true. That option is NOT in
#       upstream Percona Toolkit (it came from a 2014 Kakao patch), so pt-osc rejected it at option
#       parsing and the execute path could never run. To change a PRIMARY KEY and PARTITION in one
#       pass -- the case that option existed for, since MySQL cannot do both in one ALTER -- use a
#       --plugin whose after_alter_new_table hook runs the partitioning DDL on the shadow table.
#       That hook fires with --alter already applied and before triggers or any row copy, and unlike
#       the prompt it needs no human at a terminal.

[group('mysql')]
pt-osc alter execute="false" chunk_size="1000" chunk_index="PRIMARY" max_load="Threads_running=100" sleep="0" history="false" resume="" no_check_alter="false" extra="":
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  selected=$(grep -v '^#' "$HOSTS_FILE" | grep -v '^$' | \
    fzf --prompt="pt-osc host> " --height=40% --scheme=default)
  [ -z "$selected" ] && exit 0
  host=$(echo "$selected" | cut -d: -f2)
  port=$(echo "$selected" | cut -d: -f3)
  user=$(echo "$selected" | cut -d: -f4)
  pw=$(security find-generic-password -s "mysql-db-connect" -a "$user" -w 2>/dev/null || true)
  [ -z "$pw" ] && { echo "Keychain에 비밀번호 없음 (account=$user)" >&2; exit 1; }

  database=$(MYSQL_PWD="$pw" mysql -h "$host" -P "$port" -u "$user" -Nse \
    "SELECT schema_name FROM information_schema.schemata \
     WHERE schema_name NOT IN ('mysql','sys','information_schema','performance_schema') \
     ORDER BY schema_name" | \
    fzf --prompt="pt-osc schema> " --height=40% --scheme=default)
  [ -z "$database" ] && exit 0

  table=$(MYSQL_PWD="$pw" mysql -h "$host" -P "$port" -u "$user" -D "$database" -Nse \
    "SELECT table_name FROM information_schema.tables \
     WHERE table_schema=DATABASE() AND table_type='BASE TABLE' \
     ORDER BY table_name" \
    | fzf --prompt="pt-osc table> " --height=60% --scheme=default)
  [ -z "$table" ] && exit 0

  cnf=$(mktemp)
  chmod 600 "$cnf"
  trap 'rm -f "$cnf"' EXIT
  printf '[client]\npassword=%s\n' "$pw" > "$cnf"

  args=(
    --defaults-file="$cnf"
    --host="$host" --port="$port" --user="$user"
    --alter="{{alter}}"
    --chunk-size={{chunk_size}}
    --chunk-index={{chunk_index}}
    --max-load="{{max_load}}"
    --set-vars="innodb_lock_wait_timeout=1,lock_wait_timeout=1"
    --progress=time,30
  )
  [ "{{sleep}}" != "0" ] && args+=(--sleep={{sleep}})
  # --resume can only continue a run that recorded itself, so it implies history.
  { [ "{{history}}" = "true" ] || [ -n "{{resume}}" ]; } && args+=(--history)
  [ -n "{{resume}}" ] && args+=(--resume={{resume}})
  [ "{{no_check_alter}}" = "true" ] && args+=(--no-check-alter)
  if [ "{{execute}}" = "true" ]; then
    # Keep the artifacts of a REAL run for manual inspection/cleanup, and because --resume needs
    # all three. A dry run has nothing worth keeping -- it never touched the original table -- and
    # measured: with these flags a dry run leaves _<tbl>_new behind, so the next dry run of the
    # same table collides with it.
    args+=(--no-drop-old-table --no-drop-new-table --no-drop-triggers --execute)
  else
    args+=(--dry-run)
  fi
  [ -n "{{extra}}" ] && args+=({{extra}})

  echo "target : ${database}.${table} on ${host}:${port}"
  echo "alter  : {{alter}}"
  [ -n "{{resume}}" ] && echo "resume : job_id {{resume}}"
  [ "{{sleep}}" != "0" ] && echo "sleep  : {{sleep}}s per chunk"
  if [ "{{execute}}" = "true" ]; then
    if [ "{{history}}" = "true" ] || [ -n "{{resume}}" ]; then
      echo "mode   : EXECUTE (progress in percona.pt_osc_history; note the job_id to --resume)"
    else
      echo "mode   : EXECUTE (no history -- pass history=true to make --resume possible)"
    fi
  else
    echo "mode   : DRY RUN - pass execute=true to apply"
  fi
  pt-online-schema-change "${args[@]}" D="$database",t="$table"

# PostgreSQL (pg_dump / pg_restore)
#
# 요구사항: libpq client tools (brew install libpq  또는  postgresql@16).
# 비밀번호는 mysqlsh 처럼 미지정 시 pg_dump/pg_restore 가 자동 프롬프트합니다
# (또는 PGPASSWORD / ~/.pgpass 사용). PG 덤프는 인스턴스 전체가 아니라 DB 단위입니다.

# hint: host: e.g. <pg host from ~/.config/mysql/hosts>
# hint: user: e.g. <db user>
# hint: database: target database (PG는 DB 단위 덤프)
# hint: port: server port (default: 5432)
# hint: threads: parallel jobs (default: 4)
# hint: outdir: output directory (default: pgdump_<database>_<timestamp>)

[group('postgres')]
pg-dump-data host user database port="5432" threads="4" outdir="":
  #!/usr/bin/env bash
  set -euo pipefail
  timestamp=$(date +%Y%m%d_%H%M%S)
  out="{{outdir}}"
  [ -z "$out" ] && out="pgdump_{{database}}_${timestamp}"
  pg_dump --host="{{host}}" --port="{{port}}" --username="{{user}}" --dbname="{{database}}" \
    --format=directory --jobs={{threads}} --no-sync --file="$out"
  echo "Written: $out/"

# hint: host: e.g. <pg host from ~/.config/mysql/hosts>
# hint: user: e.g. <db user>
# hint: database: target database
# hint: tables: comma-separated table names (schema-qualified OK, e.g. public.t1,app.t2)
# hint: port: server port (default: 5432)
# hint: threads: parallel jobs (default: 4)
# hint: outdir: output directory (default: pgdump_<database>_tables_<timestamp>)

[group('postgres')]
pg-dump-tables host user database tables port="5432" threads="4" outdir="":
  #!/usr/bin/env bash
  set -euo pipefail
  timestamp=$(date +%Y%m%d_%H%M%S)
  out="{{outdir}}"
  [ -z "$out" ] && out="pgdump_{{database}}_tables_${timestamp}"
  IFS=',' read -r -a raw_tbl_array <<< "{{tables}}"
  [ "${#raw_tbl_array[@]}" -gt 0 ] || { echo "No tables provided" >&2; exit 1; }
  tbl_args=()
  for table in "${raw_tbl_array[@]}"; do
    table=$(printf '%s' "$table" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    [ -z "$table" ] && { echo "Empty table name in tables list" >&2; exit 1; }
    tbl_args+=( --table="$table" )
  done
  pg_dump --host="{{host}}" --port="{{port}}" --username="{{user}}" --dbname="{{database}}" \
    --format=directory --jobs={{threads}} --no-sync --file="$out" "${tbl_args[@]}"
  echo "Written: $out/"

# hint: host: e.g. <pg host from ~/.config/mysql/hosts>
# hint: user: e.g. <db user>
# hint: database: target database
# hint: port: server port (default: 5432)
# hint: threads: parallel jobs (default: 4)
# hint: outdir: output directory (default: pgdump_<database>_nodata_<timestamp>)

[group('postgres')]
pg-dump-no-data host user database port="5432" threads="4" outdir="":
  #!/usr/bin/env bash
  set -euo pipefail
  timestamp=$(date +%Y%m%d_%H%M%S)
  out="{{outdir}}"
  [ -z "$out" ] && out="pgdump_{{database}}_nodata_${timestamp}"
  # No --jobs here: pg_dump parallelises data dumping, and --schema-only has no
  # data to split, so the flag would do nothing.
  pg_dump --host="{{host}}" --port="{{port}}" --username="{{user}}" --dbname="{{database}}" \
    --format=directory --schema-only --no-sync --file="$out"
  echo "Written: $out/"

# hint: host: e.g. <pg host from ~/.config/mysql/hosts>
# hint: user: e.g. <db user>
# hint: database: target database to restore INTO (must already exist)
# hint: indir: dump directory from pg-dump-data / pg-dump-tables
# hint: port: server port (default: 5432)
# hint: threads: parallel jobs (default: 4)
# hint: on_exist: existing objects -> error (default, stop on error) | drop (--clean --if-exists) | ignore (continue past errors)
# hint: no_owner: strip ownership/privileges -> true (default, RDS-safe) | false (preserve owners)

[group('postgres')]
[confirm("Load dump into " + database + " on " + host + "?")]
pg-load host user database indir port="5432" threads="4" on_exist="error" no_owner="true":
  #!/usr/bin/env bash
  set -euo pipefail

  restore_args=(
    --host="{{host}}" --port="{{port}}" --username="{{user}}" --dbname="{{database}}"
    --format=directory --jobs={{threads}}
  )

  case "{{on_exist}}" in
    drop)     restore_args+=(--clean --if-exists) ;;
    ignore)   ;;
    error|"") restore_args+=(--exit-on-error) ;;
    *) echo "on_exist must be one of: error | drop | ignore" >&2; exit 1 ;;
  esac

  case "{{no_owner}}" in
    true|"")  restore_args+=(--no-owner --no-privileges) ;;
    false)    ;;
    *) echo "no_owner must be true or false" >&2; exit 1 ;;
  esac

  pg_restore "${restore_args[@]}" "{{indir}}"
  echo "Loaded: {{indir}} into {{database}}"

# hint: host/user/database/indir/port/threads/on_exist/no_owner: pg-load 와 동일
# hint: maint_mem: 인덱스 빌드용 maintenance_work_mem (default: 1GB)
#
# pg-load + 세션 튜닝(PGOPTIONS) + 로드 후 ANALYZE. 대용량 복구용 opt-in.
# 주의: 병렬(-j threads) 인덱스 빌드 구간에 워커당 maint_mem 만큼 메모리 사용
#       (예: threads=4, maint_mem=1GB -> 피크 ~4GB). 타겟 RAM 보고 조절.
# synchronous_commit=off 라 복구 중 크래시 시 재실행 필요(데이터 유실 걱정 X, 재적재).

[group('postgres')]
pg-load-fast host user database indir port="5432" threads="4" on_exist="error" no_owner="true" maint_mem="1GB":
  #!/usr/bin/env bash
  set -euo pipefail
  export PGOPTIONS="-c maintenance_work_mem={{maint_mem}} -c synchronous_commit=off -c statement_timeout=0"
  echo ">> PGOPTIONS=$PGOPTIONS"
  just --justfile "{{justfile()}}" pg-load \
    "{{host}}" "{{user}}" "{{database}}" "{{indir}}" "{{port}}" "{{threads}}" "{{on_exist}}" "{{no_owner}}"
  echo ">> ANALYZE {{database}} ..."
  psql --host="{{host}}" --port="{{port}}" --username="{{user}}" --dbname="{{database}}" -c "ANALYZE;"
  echo "Fast-loaded + analyzed: {{indir}} into {{database}}"

# hint: host: e.g. <pg host from ~/.config/mysql/hosts>
# hint: user: e.g. <db user>
# hint: port: server port (default: 5432)
# hint: raw_sql: output file (default: pg_roles_<timestamp>.sql)
#
# 클러스터 전역 role/권한 덤프. --no-role-passwords 로 RDS(pg_authid 읽기 차단)에서도 동작.
# 비밀번호는 덤프되지 않으므로 타겟에서 별도 설정 필요.

[group('postgres')]
pg-dump-roles host user port="5432" raw_sql="":
  #!/usr/bin/env bash
  set -euo pipefail
  timestamp=$(date +%Y%m%d_%H%M%S)
  out="{{raw_sql}}"
  [ -z "$out" ] && out="pg_roles_${timestamp}.sql"
  pg_dumpall --host="{{host}}" --port="{{port}}" --username="{{user}}" \
    --roles-only --no-role-passwords > "$out"
  echo "Written: $out"
  echo ""
  echo "== RDS-reserved / built-in roles (RDS import 전 제거 권장) =="
  grep -nE 'rds_superuser|rds_replication|rds_iam|rds_password|rds_ad|rdsadmin|rdstopmgr|CREATE ROLE (pg_|rds)' "$out" || echo "  (none)"
  echo ""
  echo "Review $out, then run: just pg-import-roles <target_host> <target_user> $out"

# hint: host: e.g. <pg host from ~/.config/mysql/hosts>
# hint: user: e.g. <db user>
# hint: input_sql: roles SQL from pg-dump-roles
# hint: port: server port (default: 5432)
# hint: database: maintenance DB to connect to (default: postgres)

[group('postgres')]
[confirm("Apply roles from " + input_sql + " to " + host + "?")]
pg-import-roles host user input_sql port="5432" database="postgres":
  #!/usr/bin/env bash
  set -euo pipefail
  psql --host="{{host}}" --port="{{port}}" --username="{{user}}" --dbname="{{database}}" \
    -v ON_ERROR_STOP=0 -f "{{input_sql}}"
  echo "Imported: {{input_sql}}"

# AWS DMS

DMS_CLI := "cd " + DMSCTL_ROOT + "/cli && uv run dms"

# DMS 전체 상태 (diff 기반: AWS vs 코드)
[group('dms')]
dms-status:
  {{DMS_CLI}} status

# hint: task: e.g. prod-finance / prod-dax-master (빈값이면 전체)
# hint: source: dax / horizon / otg / soho (옵션)
[group('dms')]
dms-diff task="" source="":
  #!/usr/bin/env bash
  set -euo pipefail
  cd "{{DMSCTL_ROOT}}/cli"
  if [ -n "{{task}}" ] && [ -n "{{source}}" ]; then
    uv run dms diff "{{task}}" --source "{{source}}"
  elif [ -n "{{task}}" ]; then
    uv run dms diff "{{task}}"
  elif [ -n "{{source}}" ]; then
    uv run dms diff --source "{{source}}"
  else
    uv run dms diff
  fi

# hint: task: e.g. prod-finance / all
[group('dms')]
dms-sync task dry_run="true":
  #!/usr/bin/env bash
  set -euo pipefail
  cd "{{DMSCTL_ROOT}}/cli"
  if [ "{{dry_run}}" = "true" ]; then
    uv run dms sync {{task}} --dry-run
  else
    uv run dms sync {{task}} --force
  fi

# hint: target: e.g. prod-finance / horizon / all
[group('dms')]
[confirm("Deploy DMS task " + target + " for real (plan=" + plan + ")?")]
dms-deploy target plan="false":
  #!/usr/bin/env bash
  set -euo pipefail
  cd "{{DMSCTL_ROOT}}/cli"
  if [ "{{plan}}" = "true" ]; then
    uv run dms deploy {{target}} --plan
  else
    uv run dms deploy {{target}}
  fi

# hint: task: e.g. new-task-name
# hint: source: dax / horizon / otg / soho
# hint: tables: e.g. TABLE1,TABLE2 (또는 --from-aws 사용시 빈값)
# hint: from_aws: 기존 AWS task ID에서 import (빈값이면 tables 사용)
[group('dms')]
dms-generate task source tables="" from_aws="":
  #!/usr/bin/env bash
  set -euo pipefail
  cd "{{DMSCTL_ROOT}}/cli"
  if [ -n "{{from_aws}}" ]; then
    uv run dms generate "{{task}}" --source "{{source}}" --from-aws "{{from_aws}}"
  else
    uv run dms generate "{{task}}" --source "{{source}}" --tables "{{tables}}"
  fi

# hint: task: e.g. prod-finance
# hint: table: e.g. NEW_TABLE
[group('dms')]
dms-table-add task table:
  {{DMS_CLI}} tables add "{{task}}" "{{table}}"

# hint: task: e.g. prod-finance
# hint: table: e.g. OLD_TABLE
[group('dms')]
dms-table-remove task table:
  {{DMS_CLI}} tables remove "{{task}}" "{{table}}"

# hint: task: e.g. prod-finance
[group('dms')]
dms-table-list task:
  {{DMS_CLI}} tables list "{{task}}"

# hint: task: e.g. prod-finance / all
[group('dms')]
dms-stop task:
  {{DMS_CLI}} task stop {{task}}

# hint: task: e.g. prod-finance / all
[group('dms')]
dms-resume task:
  {{DMS_CLI}} task resume {{task}}

# hint: task: e.g. prod-finance (빈값이면 전체)
# hint: source: dax / horizon / otg / soho (옵션)
[group('dms')]
dms-task-status task="" source="":
  #!/usr/bin/env bash
  set -euo pipefail
  cd "{{DMSCTL_ROOT}}/cli"
  if [ -n "{{task}}" ] && [ -n "{{source}}" ]; then
    uv run dms task status "{{task}}" --source "{{source}}"
  elif [ -n "{{task}}" ]; then
    uv run dms task status "{{task}}"
  elif [ -n "{{source}}" ]; then
    uv run dms task status --source "{{source}}"
  else
    uv run dms task status
  fi

# hint: task: e.g. prod-finance
[group('dms')]
dms-table-status task:
  {{DMS_CLI}} task table-status {{task}}

