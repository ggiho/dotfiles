# [deprecated: use mysqlsh-dump instead]
# hint: host: e.g. <host from ~/.config/mysql/hosts>
# hint: user: e.g. <db user>
# hint: database: target schema (empty = user DBs only, excludes mysql/sys/information_schema/performance_schema)
