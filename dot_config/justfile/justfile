# ── mysqlsh dump ──────────────────────────────────────────────────────────────
# Two entry points on the CONTENT axis (data vs DDL). SCOPE -- whole instance,
# one/many schemas, or individual tables -- is picked interactively in both.
#
# Renamed 2026-09-16 from mysqlsh-dump-data / -no-data / -tables, whose names
# mixed the two axes: every one of them already asked for the scope via fzf, so
# baking "tables" into one name made it unclear which to pick. The three bodies
# were also copy-pasted, which is how the table drill-down came to exist in only
# one of them; they now share _mysqlsh-dump-impl.
#
#   mysqlsh-dump-data    -> mysqlsh-dump
#   mysqlsh-dump-no-data -> mysqlsh-dump-ddl
#   mysqlsh-dump-tables  -> mysqlsh-dump, picking a single schema then its tables

# hint: threads: parallel threads (default: 4)
# hint: outdir: output directory (default: dump_<scope>_<timestamp>)

[group('mysqlsh')]
mysqlsh-dump threads="4" outdir="": (_mysqlsh-dump-impl "false" threads outdir)

# hint: threads: parallel threads (default: 4)
# hint: outdir: output directory (default: dump_<scope>_nodata_<timestamp>)

[group('mysqlsh')]
mysqlsh-dump-ddl threads="4" outdir="": (_mysqlsh-dump-impl "true" threads outdir)

# Private (leading _): hidden from `just --list`, so it never shows up in the
# `j` picker. Reached only through the two entry points above.
_mysqlsh-dump-impl ddl_only threads outdir:
  #!/usr/bin/env bash
  set -euo pipefail
  ddl_only="{{ddl_only}}"
  case "$ddl_only" in
    true)  suffix="_nodata" ;;
    false) suffix="" ;;
    *)     echo "ddl_only must be true or false (got: $ddl_only)" >&2; exit 1 ;;
  esac
  # Never empty, so expanding it stays safe under `set -u`.
  common_args=(--threads={{threads}} --consistent=false --compression=zstd)
  [ "$ddl_only" = true ] && common_args+=(--ddlOnly=true)
  HOSTS_FILE="{{HOSTS_FILE}}"
  selected=$(grep -v '^#' "$HOSTS_FILE" | grep -v '^$' | \
    fzf --prompt="dump host> " --height=40% --scheme=default)
  [ -z "$selected" ] && exit 0
  host=$(echo "$selected" | cut -d: -f2)
  port=$(echo "$selected" | cut -d: -f3)
  user=$(echo "$selected" | cut -d: -f4)
  pw=$(security find-generic-password -s "mysql-db-connect" -a "$user" -w 2>/dev/null || true)
  [ -z "$pw" ] && { echo "Keychain에 비밀번호 없음 (account=$user)" >&2; exit 1; }
  all_marker="[ALL SCHEMAS (dump-instance)]"
  # Tab selects several schemas; util dump-schemas takes a list. Picking the ALL
  # marker switches to dump-instance instead.
  schemas=$( { echo "$all_marker"; \
    MYSQL_PWD="$pw" mysql -h "$host" -P "$port" -u "$user" -Nse \
      "SELECT schema_name FROM information_schema.schemata \
       WHERE schema_name NOT IN ('mysql','sys','information_schema','performance_schema') \
       ORDER BY schema_name"; } | \
    fzf --multi --prompt="dump schemas (Tab=multi)> " --height=50% --scheme=default)
  [ -z "$schemas" ] && exit 0
  schema_count=$(printf '%s\n' "$schemas" | grep -c .)
  if printf '%s\n' "$schemas" | grep -qxF "$all_marker"; then
    database="$all_marker"
  elif [ "$schema_count" -eq 1 ]; then
    database="$schemas"
  else
    database="multi"
  fi
  all_tbl_marker="[ALL TABLES]"
  tbl_array=()
  # A single schema can be narrowed to individual tables. Several schemas (or the
  # ALL marker) stay on the whole-schema path, since util dump-tables takes one
  # schema at a time.
  if [ "$database" != "$all_marker" ] && [ "$schema_count" -eq 1 ]; then
    # -D connects to the schema so DATABASE() supplies it; the name is never
    # interpolated into SQL. Avoids backslash-escaped quotes, which the `j`
    # wrapper's re-quoting turns into an unterminated string.
    mapfile -t tbl_picks < <( { echo "$all_tbl_marker"; \
      MYSQL_PWD="$pw" mysql -h "$host" -P "$port" -u "$user" -D "$database" -Nse \
        "SELECT table_name FROM information_schema.tables \
         WHERE table_schema=DATABASE() AND table_type='BASE TABLE' \
         ORDER BY table_name"; } \
      | fzf --multi --prompt="dump tables (Tab=multi, Esc=cancel)> " --height=60% --scheme=default \
      | grep .)
    [ "${#tbl_picks[@]}" -gt 0 ] || { echo "No tables selected" >&2; exit 0; }
    if ! printf '%s\n' "${tbl_picks[@]}" | grep -qxF "$all_tbl_marker"; then
      tbl_array=("${tbl_picks[@]}")
    fi
  fi
  timestamp=$(date +%Y%m%d_%H%M%S)
  out="{{outdir}}"
  dump_log=$(mktemp)
  trap 'rm -f "$dump_log"' EXIT
  if [ "${#tbl_array[@]}" -gt 0 ]; then
    [ -z "$out" ] && out="dump_${database}_tables${suffix}_${timestamp}"
    echo "Dumping ${#tbl_array[@]} table(s) from ${database}..."
    printf '%s\n' "$pw" | mysqlsh --host="$host" --port="$port" --user="$user" --passwords-from-stdin \
      -- util dump-tables "$database" "${tbl_array[@]}" \
      --outputUrl="$out" "${common_args[@]}" 2>&1 | tee "$dump_log"
  elif [ "$database" = "$all_marker" ]; then
    [ -z "$out" ] && out="dump_all${suffix}_${timestamp}"
    printf '%s\n' "$pw" | mysqlsh --host="$host" --port="$port" --user="$user" --passwords-from-stdin \
      -- util dump-instance "$out" "${common_args[@]}" 2>&1 | tee "$dump_log"
  else
    if [ "$schema_count" -eq 1 ]; then
      [ -z "$out" ] && out="dump_${database}${suffix}_${timestamp}"
    else
      [ -z "$out" ] && out="dump_${schema_count}schemas${suffix}_${timestamp}"
    fi
    # Word splitting is what turns the newline-separated picks into separate
    # arguments, so build an array rather than interpolating the variable.
    mapfile -t schema_args < <(printf '%s\n' "$schemas" | grep .)
    printf '%s\n' "$pw" | mysqlsh --host="$host" --port="$port" --user="$user" --passwords-from-stdin \
      -- util dump-schemas "${schema_args[@]}" \
      --outputUrl="$out" "${common_args[@]}" 2>&1 | tee "$dump_log"
  fi
  # The `j` wrapper used to strip `set -euo pipefail` from the recipe, so a failed
  # mysqlsh did not abort the script. That is fixed, but scanning the output is
  # kept as a belt-and-braces check since mysqlsh's exit status was never verified.
  if grep -qE '^ERROR: ' "$dump_log"; then
    echo "Dump failed: $out" >&2
    exit 1
  fi
  echo "Written: $out/"

# hint: host: e.g. aurora-skt-otg-uat-cluster.cluster-czdk59pd0a4y.ap-northeast-2.rds.amazonaws.com
# hint: user: e.g. <db user>
# hint: port: server port (default: 3306; tunneled hosts e.g. Horizon PROD use 13306)
# hint: threads: parallel threads (default: 4)
# hint: target_schema: optional schema to load into; leave empty to use dump schema
# hint: on_exist: existing objects -> error (default) | drop (drop & recreate) | ignore (skip)
# hint: force_drop: allow on_exist=drop on a DDL-only dump (= empties the tables); default false
# note: on_exist=drop on a ddlOnly dump is refused -- it drops live rows with nothing to reload
# note: dump directory is picked via fzf (searches ./ up to 2 levels for @.json); none found -> type path

[group('mysqlsh')]
[confirm("Load dump into " + host + " (schema: " + target_schema + ", on_exist=" + on_exist + ")?")]
mysqlsh-load host user port="3306" threads="4" target_schema="" on_exist="error" force_drop="false":
  #!/usr/bin/env bash
  set -euo pipefail

  mapfile -t dumps < <(find . -maxdepth 2 -type f -name '@.json' 2>/dev/null | sed 's:/@\.json$::' | sort)
  if [ "${#dumps[@]}" -gt 0 ]; then
    indir=$(printf '%s\n' "${dumps[@]}" | \
      fzf --prompt="load dir> " --height=40% --scheme=default)
  else
    read -rp "dump directory (경로 직접 입력): " indir
  fi
  [ -z "$indir" ] && exit 0
  [ -d "$indir" ] || { echo "디렉토리 없음: $indir" >&2; exit 1; }

  target_schema="{{target_schema}}"
  # mysqlsh ties a progress file to the target server's UUID, so one dump loaded
  # into several environments must not share it (MYSQLSH 53027). Key the name by
  # host:port as well as schema.
  safe_target=$(printf '%s' "{{host}}:{{port}}" | tr -c 'A-Za-z0-9_.-' '_')
  progress_file="$indir/.load_progress_${safe_target}"
  load_args=(
    -- util load-dump "$indir"
    --threads={{threads}}
  )

  # A ddlOnly dump carries no data, so dropExistingObjects on one is a silent
  # TRUNCATE: mysqlsh drops the live table and recreates it from DDL with nothing
  # to reload. This bit admin_portal.faq_view on 2026-09-16 -- 577 rows loaded at
  # 15:55 were destroyed by a ddlOnly load at 16:09. Refuse the combination and
  # make the caller pick: ignore (keep the data) or force_drop=true (knowingly
  # empty the tables).
  ddl_only_dump=false
  if [ -f "$indir/@.json" ] && python3 -c "import json,sys; sys.exit(0 if json.load(open('$indir/@.json')).get('options',{}).get('ddlOnly') else 1)" 2>/dev/null; then
    ddl_only_dump=true
  fi

  case "{{on_exist}}" in
    drop)
      if [ "$ddl_only_dump" = true ] && [ "{{force_drop}}" != "true" ]; then
        echo "거부: 이 덤프는 DDL만 담고 있습니다 (@.json options.ddlOnly=true)." >&2
        echo "      on_exist=drop 으로 로드하면 대상 테이블을 drop 후 빈 껍데기로 재생성합니다" >&2
        echo "      -- 되돌릴 데이터가 덤프에 없으므로 사실상 TRUNCATE 입니다." >&2
        echo "      데이터를 지키려면: on_exist=ignore" >&2
        echo "      정말 비우려면  : force_drop=true" >&2
        exit 1
      fi
      load_args+=(--dropExistingObjects=true) ;;
    ignore)   load_args+=(--ignoreExistingObjects=true) ;;
    error|"") ;;
    *) echo "on_exist must be one of: error | drop | ignore" >&2; exit 1 ;;
  esac

  if [ -n "$target_schema" ]; then
    safe_schema=$(printf '%s' "$target_schema" | tr -c 'A-Za-z0-9_.-' '_')
    progress_file="$indir/.load_progress_${safe_target}_${safe_schema}"
    load_args+=(--schema="$target_schema")
  fi

  load_args+=(--progressFile="$progress_file")

  # mysqlsh's exit status alone was never verified as reliable here, so keep the
  # live output via tee and scan it for "ERROR: MYSQLSH nnnnn" as well.
  load_log=$(mktemp)
  trap 'rm -f "$load_log"' EXIT
  printf '%s\n' "$pw" | mysqlsh --host="{{host}}" --port={{port}} --user="{{user}}" --passwords-from-stdin "${load_args[@]}" 2>&1 | tee "$load_log"
  if grep -qE '^ERROR: ' "$load_log"; then
    echo "Load failed: $indir" >&2
    exit 1
  fi
  if [ -n "$target_schema" ]; then
    echo "Loaded: $indir into schema $target_schema"
  else
    echo "Loaded: $indir"
  fi

# hint: host: e.g. aurora-skt-otg-uat-cluster.cluster-czdk59pd0a4y.ap-northeast-2.rds.amazonaws.com
# hint: user: e.g. <db user>
# hint: indir: dump directory from mysqlsh-dump (single schema + tables)
# hint: target_schema: final schema to move into (e.g. datawarehouse)
# hint: source_table: dumped table name before rename (e.g. fact_enrollment)
# hint: target_table: final table name after rename (e.g. fact_enrollment_new)
# hint: port: server port (default: 3306; tunneled hosts e.g. Horizon PROD use 13306)
# hint: threads: parallel threads (default: 4)

[group('mysqlsh')]
[confirm("Drop and reload " + target_schema + "." + target_table + " on " + host + "?")]
mysqlsh-load-rename-table host user indir target_schema source_table target_table port="3306" threads="4":
  #!/usr/bin/env bash
  set -euo pipefail

  escape_ident() {
    printf '%s' "$1" | sed 's/`/``/g'
  }

  pw=$(security find-generic-password -s "mysql-db-connect" -a "{{user}}" -w 2>/dev/null || true)
  [ -z "$pw" ] && { echo "Keychain에 비밀번호 없음 (account={{user}})" >&2; exit 1; }

  # One helper for all four calls: supplies the password once (mysqlsh would
  # otherwise prompt per invocation) and fails on "ERROR: ..." even when mysqlsh
  # exits 0, which it does for some errors.
  run_mysqlsh() {
    local log rc=0
    log=$(mktemp)
    printf '%s\n' "$pw" | mysqlsh --host="{{host}}" --port={{port}} --user="{{user}}" --passwords-from-stdin "$@" 2>&1 | tee "$log" || rc=$?
    if grep -qE '^ERROR: ' "$log"; then rc=1; fi
    rm -f "$log"
    return $rc
  }

  timestamp=$(date +%Y%m%d_%H%M%S)
  temp_schema="_tmp_restore_{{source_table}}_${timestamp}"
  tmp_schema_esc=$(escape_ident "$temp_schema")
  source_table_esc=$(escape_ident "{{source_table}}")
  target_schema_esc=$(escape_ident "{{target_schema}}")
  target_table_esc=$(escape_ident "{{target_table}}")
  progress_file="{{indir}}/.load_progress_${temp_schema}_{{source_table}}"

  cleanup_temp_schema() {
    local cleanup_sql
    printf -v cleanup_sql 'DROP DATABASE IF EXISTS `%s`;' "$tmp_schema_esc"
    run_mysqlsh --sql -e "$cleanup_sql"
  }

  on_error() {
    echo "Restore failed. Temporary schema kept: $temp_schema" >&2
  }
  trap on_error ERR

  printf -v create_sql 'CREATE DATABASE IF NOT EXISTS `%s`; CREATE DATABASE IF NOT EXISTS `%s`;'     "$tmp_schema_esc" "$target_schema_esc"
  run_mysqlsh --sql -e "$create_sql"

  printf -v load_js 'util.loadDump("%s", {schema: "%s", threads: %s, progressFile: "%s"})'     "{{indir}}" "$temp_schema" "{{threads}}" "$progress_file"
  run_mysqlsh --js -e "$load_js"

  printf -v rename_sql 'RENAME TABLE `%s`.`%s` TO `%s`.`%s`;'     "$tmp_schema_esc" "$source_table_esc" "$target_schema_esc" "$target_table_esc"
  run_mysqlsh --sql -e "$rename_sql"

  cleanup_temp_schema
  trap - ERR
  echo "Loaded {{indir}} into {{target_schema}}.{{target_table}} via temp schema $temp_schema"

# MySQL 진단 (읽기 전용)

# 누적 실행시간 기준 느린 쿼리. performance_schema digest 라 slow log 설정과 무관하다.
# hint: top: 보여줄 쿼리 수 (default: 15)
# hint: schema: 특정 스키마만 (비우면 전체)
[group('mysql')]
mysql-top-queries top="15" schema="":
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  {{MYSQL_CONNECT}}
  setup_conn "host" || exit 0
  color=1; { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0
  filter="SCHEMA_NAME IS NOT NULL"
  [ -n "{{schema}}" ] && filter="SCHEMA_NAME = '"'"'{{schema}}'"'"'"
  run_sql -e "
    SELECT SCHEMA_NAME AS \`schema\`,
           COUNT_STAR AS execs,
           ROUND(SUM_TIMER_WAIT/1e12, 1) AS total_s,
           ROUND(AVG_TIMER_WAIT/1e9, 1) AS avg_ms,
           SUM_ROWS_EXAMINED AS rows_examined,
           LEFT(REPLACE(DIGEST_TEXT, '\n', ' '), 90) AS query
    FROM performance_schema.events_statements_summary_by_digest
    WHERE $filter
    ORDER BY SUM_TIMER_WAIT DESC LIMIT {{top}}" \
    | COLOR="$color" CELL=90 python3 "{{TABLE_PY}}"

# 실행 중인 쿼리와 락 대기. 장애 대응용.
# hint: min_sec: 이 시간 이상 실행 중인 것만 (default: 0 = 전부)
[group('mysql')]
mysql-sessions min_sec="0":
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  {{MYSQL_CONNECT}}
  setup_conn "host" || exit 0
  color=1; { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0

  echo "== connections ==" >&2
  run_sql -e "
    SELECT (SELECT VARIABLE_VALUE FROM performance_schema.global_status
            WHERE VARIABLE_NAME='Threads_connected') AS connected,
           @@max_connections AS max_conn,
           (SELECT COUNT(*) FROM information_schema.innodb_trx) AS open_trx" \
    | COLOR="$color" python3 "{{TABLE_PY}}"

  echo "== running queries ==" >&2
  run_sql -e "
    SELECT p.ID AS id, p.USER AS user, p.DB AS db, p.TIME AS sec, p.STATE AS state,
           LEFT(REPLACE(COALESCE(p.INFO, ''), '\n', ' '), 70) AS query
    FROM information_schema.PROCESSLIST p
    WHERE p.COMMAND <> 'Sleep' AND p.ID <> CONNECTION_ID() AND p.TIME >= {{min_sec}}
    ORDER BY p.TIME DESC" \
    | COLOR="$color" CELL=70 python3 "{{TABLE_PY}}"

  echo "== lock waits ==" >&2
  run_sql -e "
    SELECT r.trx_id AS waiting_trx, r.trx_mysql_thread_id AS waiting_thread,
           LEFT(r.trx_query, 40) AS waiting_query,
           b.trx_id AS blocking_trx, b.trx_mysql_thread_id AS blocking_thread,
           LEFT(COALESCE(b.trx_query, ''), 40) AS blocking_query
    FROM performance_schema.data_lock_waits w
    JOIN information_schema.innodb_trx r ON r.trx_id = w.REQUESTING_ENGINE_TRANSACTION_ID
    JOIN information_schema.innodb_trx b ON b.trx_id = w.BLOCKING_ENGINE_TRANSACTION_ID" \
    | COLOR="$color" CELL=40 python3 "{{TABLE_PY}}"

# 스키마/테이블 크기 TOP N.
# hint: top: 보여줄 테이블 수 (default: 20)
[group('mysql')]
mysql-size top="20":
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  {{MYSQL_CONNECT}}
  setup_conn "host" || exit 0
  color=1; { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0

  echo "== by schema ==" >&2
  run_sql -e "
    SELECT table_schema AS \`schema\`, COUNT(*) AS tables,
           ROUND(SUM(data_length)/1048576, 1) AS data_mb,
           ROUND(SUM(index_length)/1048576, 1) AS index_mb,
           ROUND(SUM(data_length+index_length)/1048576, 1) AS total_mb
    FROM information_schema.tables
    WHERE table_schema NOT IN ('mysql','sys','information_schema','performance_schema')
    GROUP BY table_schema ORDER BY SUM(data_length+index_length) DESC" \
    | COLOR="$color" python3 "{{TABLE_PY}}"

  echo "== by table ==" >&2
  run_sql -e "
    SELECT table_schema AS \`schema\`, table_name AS \`table\`, table_rows AS \`rows\`,
           ROUND(data_length/1048576, 1) AS data_mb,
           ROUND(index_length/1048576, 1) AS index_mb
    FROM information_schema.tables
    WHERE table_schema NOT IN ('mysql','sys','information_schema','performance_schema')
    ORDER BY data_length+index_length DESC LIMIT {{top}}" \
    | COLOR="$color" python3 "{{TABLE_PY}}"

# 안 쓰는 인덱스와 중복 인덱스. 서버가 재시작된 뒤 통계가 쌓여야 의미가 있다.
[group('mysql')]
mysql-unused-indexes:
  #!/usr/bin/env bash
  set -euo pipefail
  HOSTS_FILE="{{HOSTS_FILE}}"
  {{MYSQL_CONNECT}}
  setup_conn "host" || exit 0
  color=1; { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } || color=0

