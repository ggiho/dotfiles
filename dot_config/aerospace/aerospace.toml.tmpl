# AeroSpace config (chezmoi template: dot_config/aerospace/aerospace.toml.tmpl).
#
# Keys: alt = go there, alt-cmd = take the window along. Focus keys (alt-hjkl) are only active in
# 'main'; the terminal workspace uses the 'term' mode (see sync-mode.sh) so tmux gets alt-hjkl.
# The SketchyBar side is helper/wsbar.py, which receives AeroSpace events via `aerospace subscribe`.
#
# The monitor layout differs per machine and is templated below: the work Mac (two externals plus
# the notched MacBook screen) gets its own values, every other host keeps the single-external layout.
# On the work Mac set `work = true` under [data] in ~/.config/chezmoi/chezmoi.toml.
{{- /* work = true is set per machine under [data] in ~/.config/chezmoi/chezmoi.toml (never tracked) */ -}}
{{- $work := false }}{{- if hasKey . "work" }}{{- $work = .work }}{{- end }}

config-version = 2
start-at-login = true

# Pick the binding mode for this workspace. This is the only place that does it; the bar
# (helper/wsbar.py in the SketchyBar config) gets its own events through `aerospace subscribe`.
exec-on-workspace-change = ['/bin/bash', '-c',
    '$HOME/.config/aerospace/sync-mode.sh'
]
after-startup-command = ['exec-and-forget $HOME/.config/aerospace/sync-mode.sh']

{{- if not $work }}

# Switching displays re-centers the mouse on the newly focused monitor
on-focused-monitor-changed = ['move-mouse monitor-lazy-center']
{{- end }}

# Keep workspaces 7, 8, 9 and 0 alive even when empty so they match the SketchyBar items
persistent-workspaces = ['7', '8', '9', '0']

enable-normalization-flatten-containers = true
enable-normalization-opposite-orientation-for-nested-containers = true

# Workspace 9 (the small MacBook screen) is an accordion: one window big, the others peek out
# at the edge, so apps with large minimum sizes never overlap.
accordion-padding = 30
default-root-container-layout = 'tiles'
default-root-container-orientation = 'auto'

[key-mapping]
preset = 'qwerty'
{{ if $work }}
# Work PC: 7 (browser) on the left external, 8 (terminal) on the right external,
# 9 (work tools) and 0 (messengers) on the MacBook screen. Numbers are monitor
# sequence numbers from left to right; each falls back when a monitor is missing.
[workspace-to-monitor-force-assignment]
'7' = [1, 'main']
'8' = [3, 'secondary', 'main']
'9' = ['built-in', 'main']
'0' = ['built-in', 'main']
{{- else }}
# Workspace 0 (messengers) goes to the MacBook screen when open, else a secondary, else main
[workspace-to-monitor-force-assignment]
'7' = 'main'
'8' = 'main'
'9' = 'main'
'0' = ['built-in', 'secondary', 'main']
{{- end }}

[gaps]
inner.horizontal = 8
inner.vertical = 8
outer.left = 8
outer.bottom = 8
{{- if $work }}
# The notched built-in screen already loses 28pt from its visible frame, so use 10 there (28 + 10 = 38)
outer.top = [{ monitor."built-in" = 10 }, 38]
{{- else }}
outer.top = 38
{{- end }}
outer.right = 8

# Rule: alt = go there, alt-cmd = take the window along (monitor focus is the one exception: alt-cmd-comma/period).
# Focus keys (alt-hjkl) are only active in 'main'. The terminal workspace uses the
# 'term' mode below so tmux gets alt-hjkl for pane navigation (see sync-mode.sh).
[mode.main.binding]
# Direction: alt = focus, alt-cmd = move window (replaces Raycast alt-cmd-h/l split)
# A fullscreen window would hide the move, so moving leaves fullscreen first (like the focus keys do).
alt-h = 'focus left'
alt-j = 'focus down'
alt-k = 'focus up'
alt-l = 'focus right'
alt-cmd-h = ['fullscreen off', 'move left']
alt-cmd-j = ['fullscreen off', 'move down']
alt-cmd-k = ['fullscreen off', 'move up']
alt-cmd-l = ['fullscreen off', 'move right']
# Resize with alt-shift-hjkl: the key pushes that edge of the window, so it grows if a neighbour is on that side
# and shrinks otherwise; a held key keeps going (see resize.swift, AeroSpace ignores repeated key events).
alt-shift-h = 'exec-and-forget $HOME/.config/aerospace/resize h'
alt-shift-l = 'exec-and-forget $HOME/.config/aerospace/resize l'
alt-shift-j = 'exec-and-forget $HOME/.config/aerospace/resize j'
alt-shift-k = 'exec-and-forget $HOME/.config/aerospace/resize k'

# Monitors: focus prev/next display (windows go to a monitor via the workspace keys below)
alt-cmd-comma = 'focus-monitor --wrap-around prev'
alt-cmd-period = 'focus-monitor --wrap-around next'

# Workspaces
alt-u = 'workspace 7'
alt-i = 'workspace 8'
alt-o = 'workspace 9'
alt-p = 'workspace 0'
# Back to the previous workspace / the previous window. Also in 'term'.
alt-tab = 'workspace-back-and-forth'
alt-space = 'focus-back-and-forth'
alt-cmd-u = 'move-node-to-workspace --focus-follows-window 7'
alt-cmd-i = 'move-node-to-workspace --focus-follows-window 8'
alt-cmd-o = 'move-node-to-workspace --focus-follows-window 9'
alt-cmd-p = 'move-node-to-workspace --focus-follows-window 0'

# Layout / fullscreen
alt-cmd-backslash = 'layout tiles horizontal vertical'
alt-cmd-m = 'fullscreen'
alt-cmd-t = 'layout floating tiling'     # toggle the focused window between floating and tiled

# Resize the focused window; shift = reset all sizes in the workspace to equal
alt-cmd-minus = 'resize smart -50'
alt-cmd-equal = 'resize smart +50'
alt-cmd-shift-equal = 'balance-sizes'

# Enter a service mode for move/resize actions.
alt-cmd-semicolon = 'mode service'

# Active while the terminal workspace is focused: same as 'main' minus alt-hjkl (tmux pane navigation)
[mode.term.binding]
alt-tab = 'workspace-back-and-forth'
alt-space = 'focus-back-and-forth'
alt-cmd-h = ['fullscreen off', 'move left']
alt-cmd-j = ['fullscreen off', 'move down']
alt-cmd-k = ['fullscreen off', 'move up']
alt-cmd-l = ['fullscreen off', 'move right']
alt-shift-h = 'exec-and-forget $HOME/.config/aerospace/resize h'
alt-shift-l = 'exec-and-forget $HOME/.config/aerospace/resize l'
alt-shift-j = 'exec-and-forget $HOME/.config/aerospace/resize j'
alt-shift-k = 'exec-and-forget $HOME/.config/aerospace/resize k'
alt-cmd-comma = 'focus-monitor --wrap-around prev'
alt-cmd-period = 'focus-monitor --wrap-around next'
alt-u = 'workspace 7'
alt-i = 'workspace 8'
alt-o = 'workspace 9'
alt-p = 'workspace 0'
alt-cmd-u = 'move-node-to-workspace --focus-follows-window 7'
alt-cmd-i = 'move-node-to-workspace --focus-follows-window 8'
alt-cmd-o = 'move-node-to-workspace --focus-follows-window 9'
alt-cmd-p = 'move-node-to-workspace --focus-follows-window 0'
alt-cmd-backslash = 'layout tiles horizontal vertical'
alt-cmd-m = 'fullscreen'
alt-cmd-t = 'layout floating tiling'     # toggle the focused window between floating and tiled
alt-cmd-minus = 'resize smart -50'
alt-cmd-equal = 'resize smart +50'
alt-cmd-shift-equal = 'balance-sizes'
alt-cmd-semicolon = 'mode service'

[mode.service.binding]
esc = 'mode main'
enter = 'mode main'

# Move windows
h = 'move left'
j = 'move down'
k = 'move up'
l = 'move right'

# Resize
minus = 'resize smart -50'
equal = 'resize smart +50'

# Send focused window to workspace, then follow it there
7 = ['move-node-to-workspace 7', 'workspace 7', 'mode main']
8 = ['move-node-to-workspace 8', 'workspace 8', 'mode main']
9 = ['move-node-to-workspace 9', 'workspace 9', 'mode main']
0 = ['move-node-to-workspace 0', 'workspace 0', 'mode main']

# Misc helpers
f = ['layout floating tiling', 'mode main']
r = ['flatten-workspace-tree', 'mode main']
m = ['move-workspace-to-monitor --wrap-around next', 'mode main']
{{ if $work }}
# Default is floating: only the apps listed below are tiled.
# AeroSpace runs the first matching rule and stops, so keep specific apps above the catch-all.

# 7: browser
[[on-window-detected]]
if.app-id = 'com.google.Chrome'
run = 'move-node-to-workspace 7'

# 8: terminal
[[on-window-detected]]
if.app-id = 'com.github.wez.wezterm'
run = 'move-node-to-workspace 8'

# 9: work tools
[[on-window-detected]]
if.app-id = 'com.jetbrains.datagrip'
run = ['move-node-to-workspace 9', 'layout v_accordion']

[[on-window-detected]]
if.app-id = 'md.obsidian'
run = ['move-node-to-workspace 9', 'layout v_accordion']

# 0: messengers
[[on-window-detected]]
if.app-id = 'com.tinyspeck.slackmacgap'
run = 'move-node-to-workspace 0'

# Tiled, always on 7 (next to the browser)
[[on-window-detected]]
if.app-id = 'com.microsoft.Outlook'
run = ['layout tiling', 'move-node-to-workspace 7']

# KakaoTalk stays a small floating window
[[on-window-detected]]
if.app-id = 'com.kakao.KakaoTalkMac'
run = ['layout floating', 'move-node-to-workspace 0', 'exec-and-forget $HOME/.config/aerospace/keepbelow']

# Everything else floats
[[on-window-detected]]
if = 'true'
run = ['layout floating', 'exec-and-forget $HOME/.config/aerospace/keepbelow']
{{- else }}
# Other Macs keep tiling the apps they had before the work Mac's "float everything else" policy.
# App -> workspace assignment (applies when a window opens)
# 7: browsers
[[on-window-detected]]
if.app-id = 'com.google.Chrome'
run = 'move-node-to-workspace 7'

[[on-window-detected]]
if.app-id = 'com.apple.Safari'
run = 'move-node-to-workspace 7'

[[on-window-detected]]
if.app-id = 'app.zen-browser.zen'
run = 'move-node-to-workspace 7'

# 8: terminals
[[on-window-detected]]
if.app-id = 'com.github.wez.wezterm'
run = 'move-node-to-workspace 8'

[[on-window-detected]]
if.app-id = 'dev.warp.Warp-Stable'
run = 'move-node-to-workspace 8'

# 9: work tools
[[on-window-detected]]
if.app-id = 'com.jetbrains.datagrip'
run = 'move-node-to-workspace 9'

[[on-window-detected]]
if.app-id = 'notion.id'
run = 'move-node-to-workspace 9'

[[on-window-detected]]
if.app-id = 'md.obsidian'
run = 'move-node-to-workspace 9'

# 0: messengers (KakaoTalk stays a small floating window)
[[on-window-detected]]
if.app-id = 'com.kakao.KakaoTalkMac'
run = ['layout floating', 'move-node-to-workspace 0', 'exec-and-forget $HOME/.config/aerospace/keepbelow']

[[on-window-detected]]
if.app-id = 'com.tinyspeck.slackmacgap'
run = 'move-node-to-workspace 0'

[[on-window-detected]]
if.app-id = 'com.hnc.Discord'
run = 'move-node-to-workspace 0'

# Always floating
[[on-window-detected]]
if.app-id = 'com.runjuu.Input-Source-Pro'
run = ['layout floating', 'exec-and-forget $HOME/.config/aerospace/keepbelow']

[[on-window-detected]]
if.app-id = 'com.apple.systempreferences'
run = ['layout floating', 'exec-and-forget $HOME/.config/aerospace/keepbelow']

[[on-window-detected]]
if.app-id = 'com.apple.ActivityMonitor'
run = ['layout floating', 'exec-and-forget $HOME/.config/aerospace/keepbelow']

[[on-window-detected]]
if.app-id = 'com.apple.Preview'
run = ['layout floating', 'exec-and-forget $HOME/.config/aerospace/keepbelow']

[[on-window-detected]]
if.app-id = 'us.zoom.xos'
run = ['layout floating', 'exec-and-forget $HOME/.config/aerospace/keepbelow']
{{- end }}
