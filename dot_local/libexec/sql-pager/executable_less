#!/usr/bin/env python3
"""Pager for mycli and pgcli results under tmux.

Named ``less`` on purpose: click only passes colours through to a pager whose
executable is called ``less``. It runs the real /usr/bin/less.

less draws on the alternate screen (-+X) so scrolling sideways does not push a
screenful into tmux's scrollback on every repaint (scroll-on-clear), and paints
from the top (-c) so a short result does not jump up on the first repaint.

What stays on screen after quitting is handled here, by the result's size:

- Fewer lines than the screen and no line wider than it: printed directly, as
  without a pager. less would only add a screen of '~' filler.
- Fewer lines than the screen but wider: shown in less, then printed again on
  quitting, each line cut at the right edge as less showed it.
  --redraw-on-quit is not used here because it redraws a whole screen, which is
  mostly '~' filler that pushes the result itself off the top.
- As tall as the screen or taller: shown in less with --redraw-on-quit, which
  leaves the last screen, all rows, on the normal screen. That redraw is of the
  screen as it was last shown, so if it was scrolled sideways the view left
  behind is shifted too. Press ESC-{ (scroll back to the first column) before q
  to leave it unshifted.

Lines are split on newlines only and bytes are written out unchanged, except
where a reprinted line is cut. Ctrl-C is left to less while it runs.
"""

import os
import re
import signal
import subprocess
import sys
import unicodedata

LESS = "/usr/bin/less"
# An ANSI escape sequence, or else one character.
TOKEN = re.compile(r"(\x1b\[[0-9;?]*[A-Za-z])|(.)", re.S)
RESET = "\x1b[0m"


def clip(line, columns):
    """Return line cut to columns display columns, or None if it fits.

    Escape sequences take no room, tabs stop every 8 columns and East Asian
    wide characters take 2. A wide character that would cross the edge is left
    out, and a line cut while styled gets a reset.
    """
    out, col, styled = [], 0, False
    for seq, char in TOKEN.findall(line):
        if seq:
            out.append(seq)
            styled = seq not in ("\x1b[m", RESET)
            continue
        if char == "\t":
            w = 8 - col % 8
            char = " " * w
        else:
            w = 2 if unicodedata.east_asian_width(char) in "WF" else 1
        if col + w > columns:
            return "".join(out) + (RESET if styled else "")
        out.append(char)
        col += w
    return None


def less(data, options):
    # Ctrl-C goes to the whole foreground group. less handles it; here it would
    # raise KeyboardInterrupt and kill less, leaving the alternate screen on.
    previous = signal.signal(signal.SIGINT, signal.SIG_IGN)
    try:
        proc = subprocess.Popen([LESS, *options], stdin=subprocess.PIPE)
        proc.communicate(data)
    finally:
        signal.signal(signal.SIGINT, previous)
    return proc.returncode


def main():
    data = sys.stdin.buffer.read()
    try:
        columns, rows = os.get_terminal_size(sys.stdout.fileno())
    except OSError:
        sys.stdout.buffer.write(data)
        return 0

    lines = data.split(b"\n")
    if lines[-1] == b"":
        lines.pop()
    tall = len(lines) >= rows
    if not tall:
        clipped = [clip(line.decode("utf-8", "surrogateescape"), columns) for line in lines]
        if all(c is None for c in clipped):
            sys.stdout.buffer.write(data)
            return 0

    options = ["-R", "-S", "-c", "-+X", "-+F"]
    if tall:
        options.append("--redraw-on-quit")
    status = less(data, options)

    if not tall:
        out = [line if c is None else c.encode("utf-8", "surrogateescape")
               for line, c in zip(lines, clipped)]
        sys.stdout.buffer.write(b"\n".join(out) + (b"\n" if data.endswith(b"\n") else b""))
        sys.stdout.flush()
    return status


if __name__ == "__main__":
    sys.exit(main())
