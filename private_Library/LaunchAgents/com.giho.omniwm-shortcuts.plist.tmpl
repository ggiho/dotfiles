<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.giho.omniwm-shortcuts</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{ .chezmoi.homeDir }}/.config/omniwm/shortcut-helper</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/.local/state/omniwm/shortcut-helper.err.log</string>
	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/.local/state/omniwm/shortcut-helper.log</string>
</dict>
</plist>
